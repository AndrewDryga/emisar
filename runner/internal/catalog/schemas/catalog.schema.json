{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.emisar.dev/v1/schemas/catalog.v7.schema.json",
  "title": "emisar pack registry catalog",
  "description": "The published catalog.json contract: installable packs, immutable content identity, and complete reviewed action descriptors. Emitted by `emisar pack catalog build`. Trust rests on the authenticated artifact plus content_hash and the runner's re-hash.",
  "type": "object",
  "required": [
    "schema_version",
    "generation",
    "packs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic identity of the mutable catalog pointer. New builds always emit it. The builder has a separate compatibility path for a legacy --previous document that predates this field."
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pack"
      },
      "minItems": 1,
      "description": "Every published pack. Never empty: a catalog with no packs is the amputated-history shape this schema exists to reject before it is carried forward as --previous."
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "description",
        "vendor",
        "homepage",
        "source_url",
        "content_hash",
        "tarball_url",
        "requires",
        "detect",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tarball_url": {
          "type": "string",
          "format": "uri"
        },
        "requires": {
          "type": "object",
          "required": [
            "os",
            "binaries"
          ],
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "binaries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "detect": {
          "$ref": "#/$defs/detect"
        },
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "previous_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/previous_version"
          }
        },
        "retired_below": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "previous_version": {
      "type": "object",
      "required": [
        "version",
        "content_hash",
        "tarball_url"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tarball_url": {
          "type": "string",
          "format": "uri"
        },
        "actions": {
          "description": "Complete descriptor snapshot. Missing on historical v1 entries, which are not executable through MCP.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/historical_action"
          }
        }
      }
    },
    "detect": {
      "type": "object",
      "required": [
        "binaries",
        "processes",
        "ports"
      ],
      "additionalProperties": false,
      "properties": {
        "binaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "default": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host_access": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_access"
          }
        },
        "verify": {
          "type": "string",
          "description": "Id of a low-risk read action in this pack."
        }
      },
      "description": "The pack's authored setup block, carried verbatim from its manifest: the credentials it reads, host caveats, and a low-risk read action that proves the pack can reach and authenticate to its target. Absent on a catalog published before this field existed, which is still valid --previous input."
    },
    "host_access": {
      "type": "object",
      "required": [
        "actions",
        "requirement",
        "recipes"
      ],
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/host_access_recipe"
          }
        }
      }
    },
    "host_access_recipe": {
      "type": "object",
      "required": [
        "name",
        "commands",
        "verify",
        "impact"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Display-only host permission commands and checks. Consumers must not execute or interpolate them."
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "description",
        "kind",
        "risk",
        "side_effects",
        "args",
        "examples",
        "search_terms"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "type": "string",
          "enum": [
            "exec",
            "script"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "side_effects": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arg"
          }
        },
        "output_schema": {
          "type": "object",
          "description": "The complete bounded Draft 2020-12 object schema enforced by the runner after redaction."
        },
        "examples": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "title",
              "args"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "args": {
                "type": "object"
              }
            }
          }
        },
        "search_terms": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "command": {
          "type": "object",
          "required": [
            "binary",
            "argv"
          ],
          "additionalProperties": false,
          "properties": {
            "binary": {
              "type": "string"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "arg": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "duration",
            "path",
            "string_array",
            "integer_array"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        },
        "default": {},
        "description": {
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enum": {
          "type": "array"
        },
        "pattern": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "allowed": {
          "type": "array"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_items": {
          "type": "integer"
        },
        "max_length": {
          "type": "integer"
        },
        "min_duration": {
          "type": "string"
        },
        "max_duration": {
          "type": "string"
        }
      }
    },
    "historical_action": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "exec",
                "script"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "side_effects": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "args": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/arg"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "output_schema": {
          "oneOf": [
            {
              "type": "object",
              "description": "The complete bounded Draft 2020-12 object schema enforced by the runner after redaction."
            },
            {
              "type": "null"
            }
          ]
        },
        "examples": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "args"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "args": {
                    "type": "object"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "search_terms": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "binary",
                "argv"
              ],
              "additionalProperties": false,
              "properties": {
                "binary": {
                  "type": "string"
                },
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A descriptor snapshot frozen at publication. Same shape as `action`, but its presence and content requirements are relaxed: a published object is immutable, so an entry cut before a field existed (or before it was populated) can never gain it. Validate CURRENT descriptors against `action`; these are history."
    }
  }
}
