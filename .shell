#!/bin/bash

# Set the gcloud project ID for the Google Cloud SDK
export CLOUDSDK_CORE_PROJECT="emisar"

# This file extends your shell environment with commands from this project.
# To use it you need to add something like this to your .bashrc or .zshrc:
#
#    GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
#    [ -f "${GIT_ROOT}/.shell" ] && source "${GIT_ROOT}/.shell"
#
# The root is pinned in a project-scoped global because loaders often source
# this file from inside a function whose GIT_ROOT is local — that local is
# gone by the time the functions below run.
EMISAR_ROOT="${GIT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null)}"

portal() {
  "${EMISAR_ROOT}/run" ops portal "$@"
}

database() {
  "${EMISAR_ROOT}/run" ops database "$@"
}

run() {
  "${EMISAR_ROOT}/run" "$@"
}

# Add the Terraform command that works from any folder within the project.
prod() {
  terraform -chdir="${EMISAR_ROOT}/infra" "$@"
}
