# Build artifacts
/bin/
/dist/
**/_build*/
*.out
/test-results/

# Stray dev binaries — `go build` from inside a module dir writes here
# (named after the dir). Build into /bin/ with `go build -o ../bin/…`.
/runner/runner
/mcp/mcp
/mcp/bin/
/emisar
/emisar-mcp

# Local runtime state from the example config
/runner/examples/var/

# Cross-compile output (the release workflows' go build matrix)
emisar-*-linux-*
emisar-*-darwin-*

# Test JSONL logs that might be dropped if a test forgets to t.TempDir()
events.jsonl
events.jsonl.*

# Erlang/BEAM crash dumps — written to the CWD when the VM aborts.
erl_crash.dump

# Editor noise
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.claude/scheduled_tasks.lock

# Local dev compose secrets — copy .env.example to .env and fill in.
/.env

# Repository documentation is always tracked. Working notes and agent history
# belong under the ignored .agent/ state below, never as hidden files in docs/.

# .agent/ is local working state — only the PUBLIC KNOWLEDGE and CONFIG are committed:
# kb/ (public current-system cards and normative rules), presets/ (orchestration
# recipes), scripts/ (agent-only enforcement), project.yaml
# (monorepo/box policy), loop.yaml, and the project Dockerfile.
# kb/internal/, tasks, the backlog drawer, pending decisions, log, and archive
# stay on the machine (no internal material in Git, no cross-agent merge
# conflicts). See AGENTS.md.
**/.agent/*
!**/.agent/scripts
!**/.agent/kb
**/.agent/kb/internal/
!**/.agent/presets
!.agent/project.yaml
!.agent/loop.yaml
!.agent/Dockerfile
.expert/*.log

# Self-signed dev/e2e TLS certs (mix phx.gen.cert)
**/priv/cert/

# Generated DEV-ONLY Keycloak CA and leaf material. Private keys must never be
# committed; `dev/run certs` creates this directory during setup.
/dev/keycloak/certs/generated/

# Terraform (infra/) — state and real var files never get committed; the provider
# lock (.terraform.lock.hcl) and *.tfvars.example DO. State can hold sensitive
# values and drifts per-operator; tfvars may carry real values.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log
