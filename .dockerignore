# Shared build context for .agent/Dockerfile, portal/Dockerfile, and
# runner/Dockerfile. MCP, cloud-init, and test-pack images have context-local files.

# Repository and local tool state
.git
.github
**/.agent
**/.expert
.claude
.codex
.gemini

# Trees and root outputs unused by every root-context image
bin
dev
dist
infra
mcp
test-results

# Dependencies and generated build output
**/_build*
**/deps
**/.elixir_ls
**/node_modules
**/cover
**/doc
**/tmp
**/*.ez
**/*.out
portal/apps/emisar/emisar-*.tar
portal/apps/emisar_web/emisar_web-*.tar
runner/runner
runner/var
emisar-*-linux-*
emisar-*-darwin-*
**/priv/static/assets
**/priv/static/cache_manifest.json
**/priv/static/**/*-????????????????????????????????.*
**/priv/static/**/*.gz

# Local configuration and runtime residue
**/.env
**/.env.*
**/erl_crash.dump
**/events.jsonl*
**/*.log
**/priv/cert

# Editor and operating-system noise
**/.idea
**/.vscode
**/*.swp
**/*.swo
**/*~
**/.DS_Store
