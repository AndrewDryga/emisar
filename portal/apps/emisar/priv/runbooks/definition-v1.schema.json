{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emisar.dev/schemas/runbook-definition-v1.json",
  "title": "Emisar runbook definition v1",
  "type": "object",
  "required": ["schema_version", "context_markdown", "inputs", "stages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "context_markdown": {
      "type": "string",
      "maxLength": 16384,
      "x-maxUtf8Bytes": 16384
    },
    "inputs": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/input"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,79}$"
    },
    "json_scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "input": {
      "type": "object",
      "required": ["id", "description", "type", "required", "sensitive"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-maxUtf8Bytes": 2048
        },
        "type": {
          "enum": ["string", "integer", "number", "boolean", "enum"]
        },
        "required": {"type": "boolean"},
        "sensitive": {"type": "boolean"},
        "default": {"$ref": "#/$defs/json_scalar"},
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "x-maxUtf8Bytes": 2048
          }
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "min_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "max_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "enum"}}},
          "then": {"required": ["enum"]},
          "else": {"not": {"required": ["enum"]}}
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": ["id", "title", "mode", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "x-maxUtf8Bytes": 320
        },
        "mode": {"enum": ["sequential", "parallel"]},
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/step"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "parallel"}}},
          "then": {"required": ["max_parallel"]},
          "else": {"not": {"required": ["max_parallel"]}}
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "pack",
        "action",
        "targets",
        "args",
        "outputs",
        "success",
        "wait"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "pack": {"$ref": "#/$defs/pack"},
        "action": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "targets": {"$ref": "#/$defs/targets"},
        "args": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/binding"},
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/output"}
        },
        "success": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/success"}
        },
        "wait": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/wait"}
          ]
        }
      }
    },
    "pack": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
        }
      }
    },
    "targets": {
      "type": "object",
      "required": ["selection", "refs"],
      "additionalProperties": false,
      "properties": {
        "selection": {"enum": ["all", "random_one"]},
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(group|runner):.+$",
            "maxLength": 120,
            "x-maxUtf8Bytes": 120
          }
        }
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "value"],
          "additionalProperties": false,
          "properties": {
            "source": {"const": "literal"},
            "value": {}
          }
        },
        {
          "type": "object",
          "required": ["source", "ref"],
          "additionalProperties": false,
          "properties": {
            "source": {"const": "input"},
            "ref": {"$ref": "#/$defs/stable_id"}
          }
        },
        {
          "type": "object",
          "required": ["source", "ref"],
          "additionalProperties": false,
          "properties": {
            "source": {"const": "output"},
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,79}\\.[a-z][a-z0-9_-]{0,79}$"
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "required": ["id", "source", "sensitive", "extract"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "source": {"enum": ["structured_output", "stdout", "stderr"]},
        "sensitive": {"type": "boolean"},
        "extract": {"$ref": "#/$defs/extractor"}
      }
    },
    "extractor": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "expression"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["json_pointer", "contains", "grep"]},
            "expression": {
              "type": "string",
              "maxLength": 512,
              "x-maxUtf8Bytes": 512
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "expression", "capture"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "regex"},
            "expression": {
              "type": "string",
              "maxLength": 512,
              "x-maxUtf8Bytes": 512
            },
            "capture": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(0|[1-9][0-9]*|[A-Za-z][A-Za-z0-9_]*)$"
            }
          }
        }
      ]
    },
    "success": {
      "type": "object",
      "required": ["output", "operator", "value"],
      "additionalProperties": false,
      "properties": {
        "output": {"$ref": "#/$defs/stable_id"},
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal",
            "contains",
            "one_of",
            "matches"
          ]
        },
        "value": {}
      }
    },
    "wait": {
      "type": "object",
      "required": ["interval_seconds", "timeout_seconds", "max_attempts"],
      "additionalProperties": false,
      "properties": {
        "interval_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 86400
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        }
      }
    }
  },
  "x-emisar-limits": {
    "max_definition_bytes": 65536,
    "max_definition_depth": 24,
    "max_definition_nodes": 8192,
    "max_frozen_plan_bytes": 1048576,
    "max_context_markdown_bytes": 16384,
    "max_inputs": 32,
    "max_stages": 16,
    "max_steps": 32,
    "max_target_refs_per_step": 16,
    "max_execution_items": 256,
    "max_outputs_per_step": 16,
    "max_success_conditions_per_step": 16,
    "max_supplied_inputs_bytes": 32768,
    "max_action_args_bytes": 32768,
    "max_expression_bytes": 512,
    "max_extractor_text_bytes": 65536,
    "max_extracted_value_bytes": 8192,
    "max_grep_lines": 100,
    "min_wait_interval_seconds": 5,
    "max_wait_interval_seconds": 3600,
    "min_wait_timeout_seconds": 5,
    "max_wait_timeout_seconds": 86400,
    "min_wait_attempts": 2,
    "max_wait_attempts": 100,
    "max_execution_seconds": 86400,
    "min_stage_parallelism": 1,
    "max_stage_parallelism": 16,
    "default_stage_parallelism": 5
  }
}
