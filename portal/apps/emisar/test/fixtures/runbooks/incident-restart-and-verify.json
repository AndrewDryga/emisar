{
  "schema_version": 1,
  "context_markdown": "## Incident restart and verification\n\nResolve the affected resource from the incident, restart it after approval, and wait for a healthy state.\n\nThe resource returned by diagnosis is bound into every later action.",
  "inputs": [
    {
      "id": "incident_id",
      "description": "Incident identifier recorded in the response system.",
      "type": "string",
      "required": true,
      "sensitive": false,
      "min_length": 3,
      "max_length": 80
    }
  ],
  "stages": [
    {
      "id": "diagnose",
      "title": "Resolve the affected resource",
      "mode": "sequential",
      "steps": [
        {
          "id": "resolve_resource",
          "pack": {
            "id": "aws-incident"
          },
          "action": "aws.incident_resource",
          "targets": {
            "selection": "all",
            "refs": [
              "group:aws-control"
            ]
          },
          "args": {
            "incident_id": {
              "source": "input",
              "ref": "incident_id"
            }
          },
          "outputs": [
            {
              "id": "resource_id",
              "source": "structured_output",
              "sensitive": false,
              "extract": {
                "type": "json_pointer",
                "expression": "/resource_id"
              }
            },
            {
              "id": "state",
              "source": "structured_output",
              "sensitive": false,
              "extract": {
                "type": "json_pointer",
                "expression": "/state"
              }
            }
          ],
          "success": [
            {
              "output": "state",
              "operator": "one_of",
              "value": [
                "impaired",
                "stopped"
              ]
            }
          ],
          "wait": null
        }
      ]
    },
    {
      "id": "remediate",
      "title": "Restart the resource",
      "mode": "sequential",
      "steps": [
        {
          "id": "restart_resource",
          "pack": {
            "id": "aws-incident"
          },
          "action": "aws.restart_resource",
          "targets": {
            "selection": "all",
            "refs": [
              "group:aws-control"
            ]
          },
          "args": {
            "incident_id": {
              "source": "input",
              "ref": "incident_id"
            },
            "resource_id": {
              "source": "output",
              "ref": "resolve_resource.resource_id"
            }
          },
          "outputs": [
            {
              "id": "request_id",
              "source": "structured_output",
              "sensitive": false,
              "extract": {
                "type": "json_pointer",
                "expression": "/request_id"
              }
            }
          ],
          "success": [
            {
              "output": "request_id",
              "operator": "matches",
              "value": "^req-[a-z0-9]+$"
            }
          ],
          "wait": null
        }
      ]
    },
    {
      "id": "verify",
      "title": "Wait for recovery",
      "mode": "sequential",
      "steps": [
        {
          "id": "resource_health",
          "pack": {
            "id": "aws-incident"
          },
          "action": "aws.resource_health",
          "targets": {
            "selection": "all",
            "refs": [
              "group:aws-control"
            ]
          },
          "args": {
            "resource_id": {
              "source": "output",
              "ref": "resolve_resource.resource_id"
            },
            "request_id": {
              "source": "output",
              "ref": "restart_resource.request_id"
            }
          },
          "outputs": [
            {
              "id": "healthy",
              "source": "structured_output",
              "sensitive": false,
              "extract": {
                "type": "json_pointer",
                "expression": "/healthy"
              }
            },
            {
              "id": "status",
              "source": "structured_output",
              "sensitive": false,
              "extract": {
                "type": "json_pointer",
                "expression": "/status"
              }
            }
          ],
          "success": [
            {
              "output": "healthy",
              "operator": "equals",
              "value": true
            },
            {
              "output": "status",
              "operator": "equals",
              "value": "running"
            }
          ],
          "wait": {
            "interval_seconds": 5,
            "timeout_seconds": 30,
            "max_attempts": 5
          }
        }
      ]
    }
  ]
}
