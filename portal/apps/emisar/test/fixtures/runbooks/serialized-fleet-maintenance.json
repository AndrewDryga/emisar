{
  "schema_version": 1,
  "context_markdown": "## Rolling worker maintenance\n\nInspect the fleet, maintain one host at a time, then verify the complete fleet.\n\nThe maintenance stage is intentionally serialized. A failed host stops later hosts from starting.",
  "inputs": [
    {
      "id": "change_ticket",
      "description": "Approved change or incident ticket.",
      "type": "string",
      "required": true,
      "sensitive": false,
      "min_length": 3,
      "max_length": 80
    }
  ],
  "stages": [
    {
      "id": "inspect",
      "title": "Inspect the fleet",
      "mode": "parallel",
      "max_parallel": 3,
      "steps": [
        {
          "id": "preflight_health",
          "pack": {
            "id": "fleet-maintenance"
          },
          "action": "fleet.health_report",
          "targets": {
            "selection": "all",
            "refs": [
              "group:workers"
            ]
          },
          "args": {},
          "outputs": [
            {
              "id": "failed_checks",
              "source": "stdout",
              "sensitive": false,
              "extract": {
                "type": "grep",
                "expression": "^FAIL "
              }
            }
          ],
          "success": [
            {
              "output": "failed_checks",
              "operator": "equals",
              "value": []
            }
          ],
          "wait": null
        }
      ]
    },
    {
      "id": "maintain",
      "title": "Maintain one host at a time",
      "mode": "parallel",
      "max_parallel": 1,
      "steps": [
        {
          "id": "maintain_host",
          "pack": {
            "id": "fleet-maintenance"
          },
          "action": "fleet.maintain_host",
          "targets": {
            "selection": "all",
            "refs": [
              "group:workers"
            ]
          },
          "args": {
            "change_ticket": {
              "source": "input",
              "ref": "change_ticket"
            }
          },
          "outputs": [
            {
              "id": "ready",
              "source": "structured_output",
              "sensitive": false,
              "extract": {
                "type": "json_pointer",
                "expression": "/ready"
              }
            }
          ],
          "success": [
            {
              "output": "ready",
              "operator": "equals",
              "value": true
            }
          ],
          "wait": null
        }
      ]
    },
    {
      "id": "verify",
      "title": "Verify the fleet",
      "mode": "parallel",
      "max_parallel": 3,
      "steps": [
        {
          "id": "fleet_ready",
          "pack": {
            "id": "fleet-maintenance"
          },
          "action": "fleet.readiness",
          "targets": {
            "selection": "all",
            "refs": [
              "group:workers"
            ]
          },
          "args": {},
          "outputs": [
            {
              "id": "ready",
              "source": "structured_output",
              "sensitive": false,
              "extract": {
                "type": "json_pointer",
                "expression": "/ready"
              }
            }
          ],
          "success": [
            {
              "output": "ready",
              "operator": "equals",
              "value": true
            }
          ],
          "wait": {
            "interval_seconds": 5,
            "timeout_seconds": 20,
            "max_attempts": 3
          }
        }
      ]
    }
  ]
}
