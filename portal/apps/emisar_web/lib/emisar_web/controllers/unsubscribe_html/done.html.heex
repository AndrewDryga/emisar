<main
  id="main-content"
  class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6 py-16"
>
  <div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-8">
    <h1 class="text-xl font-semibold text-zinc-100">Monthly reports are off</h1>
    <p class="mt-3 text-sm leading-relaxed text-zinc-400">
      Monthly reports for <span class="font-medium text-zinc-200">{@account_name}</span>
      are off for every Owner in this workspace. Sign-in and approval emails are not affected.
      To turn reports back on, open <span class="font-medium text-zinc-200">Team → Notifications</span>.
    </p>
    <a
      href={~p"/"}
      class="mt-6 inline-block text-sm font-medium text-brand-400 hover:text-brand-300"
    >
      Back to emisar &rarr;
    </a>
  </div>
</main>
