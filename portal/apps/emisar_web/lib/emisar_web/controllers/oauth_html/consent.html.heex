<.auth_card>
  <div class="border-b border-zinc-800 px-6 py-5">
    <h1 class="text-lg font-semibold text-zinc-50">
      Authorize <span class="text-brand-400">{@client_name}</span>
    </h1>
    <%!-- With one signed-in workspace the header names it outright; with
             several the picker in the form below owns the choice — a static
             name here would go stale the moment the operator picks another. --%>
    <p :if={match?([_], @sessions)} class="mt-1 text-sm text-zinc-400">
      wants to connect to <strong class="text-zinc-200">{hd(@sessions).account.name}</strong>
    </p>
    <p :if={length(@sessions) > 1} class="mt-1 text-sm text-zinc-400">
      wants to connect to one of the workspaces you're signed in to
    </p>
    <p :if={@callback_origin} class="mt-2 text-xs text-zinc-400">
      The authorization code will be sent to
      <span class="break-all font-mono text-[0.92em] text-zinc-300">{@callback_origin}</span>
    </p>
  </div>

  <div class="px-6 py-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400">
      This connection can
    </p>
    <ul class="mt-3 space-y-3">
      <li :for={scope <- @scopes} class="flex items-start gap-3">
        <.icon name="state.success" class="mt-0.5 h-5 w-5 flex-none text-brand-400" />
        <span class="text-sm leading-snug text-zinc-300">{scope_label(scope)}</span>
      </li>
    </ul>

    <.consent_note class="mt-5">
      The connection uses your workspace access. Policy decides which actions run,
      wait for approval, or are denied. Action requests are attributed to you and recorded
      in the audit log.
    </.consent_note>

    <.form for={%{}} action={~p"/oauth/authorize"} method="post" class="mt-6">
      <input
        :for={{key, value} <- @params}
        :if={value not in [nil, ""]}
        type="hidden"
        name={key}
        value={value}
      />

      <%!-- Which workspace the grant lands in. A browser signed in to several
               picks at the point of decision, with no default; one signed-in
               workspace rides as a hidden field — the POST authenticates the
               choice against this browser's own session for it either way. --%>
      <div :if={length(@sessions) > 1} class="mb-5">
        <.input
          type="select"
          id="consent-account"
          name="account_id"
          label="Workspace"
          label_variant={:eyebrow}
          value={nil}
          prompt="Choose a workspace"
          required
          options={
            Enum.map(@sessions, &{"#{&1.account.name} — #{&1.member_label}", &1.account.id})
          }
        />
      </div>
      <input
        :for={session <- @sessions}
        :if={match?([_], @sessions)}
        type="hidden"
        name="account_id"
        value={session.account.id}
      />

      <div class="flex flex-col gap-3">
        <.button type="submit" name="decision" value="approve" class="w-full">
          Authorize
        </.button>
        <.button variant={:secondary} type="submit" name="decision" value="deny" class="w-full">
          Deny
        </.button>
      </div>
    </.form>
  </div>

  <:footer :if={match?([_], @sessions)}>
    Signed in as <span class="text-zinc-400">{hd(@sessions).member_label}</span>
  </:footer>
</.auth_card>
