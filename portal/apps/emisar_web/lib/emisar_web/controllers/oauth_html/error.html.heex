<.auth_card>
  <div class="px-6 py-6">
    <h1 class="text-balance text-lg font-semibold text-zinc-50">
      Couldn't authorize this connection
    </h1>
    <p class="mt-3 text-sm leading-relaxed text-zinc-400">{@message}</p>
    <p class="mt-6 text-sm leading-relaxed text-zinc-400">
      Nothing was authorized. Restart the connection from your app.
    </p>
    <p class="mt-4 text-sm">
      <.doc_link href={~p"/docs/agents-and-keys"}>Agent connection help</.doc_link>
    </p>
  </div>
</.auth_card>
