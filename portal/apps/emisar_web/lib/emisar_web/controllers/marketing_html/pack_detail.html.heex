<%!-- ============================================================
  Pack detail — one published pack, all its actions, install snippet
============================================================ --%>

<div class="bg-zinc-950 text-zinc-100">
  <.marketing_nav current_user={@current_user} current={:packs} />

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <.breadcrumbs items={[{"Packs", ~p"/packs"}, {@pack.id, nil}]} />

      <%!-- Header --%>
      <div class="mt-6 flex flex-wrap items-baseline justify-between gap-3">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-50 md:text-4xl">
          {@pack.name}
        </h1>
        <span class="rounded-full bg-zinc-900 px-2.5 py-1 font-mono text-xs text-zinc-300">
          v{@pack.version}
        </span>
      </div>

      <p class="mt-4 text-lg leading-relaxed text-zinc-400 text-pretty">{@pack.description}</p>

      <%!-- Capabilities at a glance — the pack's shape derived from each action's
           risk tier under the DEFAULT policy (low/medium allowed, high gated,
           critical denied). An operator can tighten any of it. --%>
      <% by_risk = Enum.frequencies_by(@pack.actions, &to_string(&1.risk)) %>
      <% allowed = Map.get(by_risk, "low", 0) + Map.get(by_risk, "medium", 0) %>
      <% gated = Map.get(by_risk, "high", 0) %>
      <% denied = Map.get(by_risk, "critical", 0) %>
      <div class="mt-5 flex flex-wrap gap-2 text-xs">
        <span
          :if={allowed > 0}
          class="inline-flex items-center gap-1.5 rounded-full border border-brand-500/30 bg-brand-500/5 px-3 py-1 text-brand-300"
        >
          <.icon name="state.success" class="h-3.5 w-3.5" /> {allowed} allowed by default
        </span>
        <span
          :if={gated > 0}
          class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/5 px-3 py-1 text-amber-300"
        >
          <.icon name="state.pending" class="h-3.5 w-3.5" /> {gated} need approval by default
        </span>
        <span
          :if={denied > 0}
          class="inline-flex items-center gap-1.5 rounded-full border border-rose-500/30 bg-rose-500/5 px-3 py-1 text-rose-300"
        >
          <.icon name="state.denied" class="h-3.5 w-3.5" /> {denied} denied by default
        </span>
      </div>

      <%!-- Meta strip: vendor, OS, requirements, source --%>
      <div class="mt-6 grid grid-cols-2 gap-3 rounded-xl border border-zinc-900 bg-zinc-950/40 p-4 text-sm sm:grid-cols-4">
        <.meta_field label="Pack ID">
          <span class="truncate font-mono text-zinc-200">{@pack.id}</span>
        </.meta_field>
        <.meta_field label="Vendor">
          <span class="truncate text-zinc-200">{@pack.vendor}</span>
        </.meta_field>
        <.meta_field label="OS">
          <span class="truncate text-zinc-200">
            {Enum.join(@pack.requires_os, ", ")}
          </span>
        </.meta_field>
        <.meta_field label="Actions">
          <span class="text-zinc-200">{length(@pack.actions)}</span>
        </.meta_field>
      </div>

      <%!-- Required-binaries banner — only when present. Operators
           need to confirm these are on the host first. --%>
      <div
        :if={@pack.requires_binaries != []}
        class="mt-4 flex items-start gap-3 rounded-xl border border-amber-500/30 bg-amber-500/[0.04] p-4"
      >
        <.icon name="state.info" class="mt-0.5 h-5 w-5 flex-none text-amber-300" />
        <div class="text-sm text-amber-100/90">
          <strong class="text-amber-100">Required binaries.</strong>
          Install these on the host before relying on the pack — an action that calls a missing
          one fails at run time.
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            <code
              :for={bin <- @pack.requires_binaries}
              class="rounded bg-amber-500/15 px-2 py-0.5 font-mono text-xs font-medium text-amber-200"
            >
              {bin}
            </code>
          </div>
        </div>
      </div>

      <%!-- Install snippet — copy-paste onto a runner host --%>
      <section class="mt-10">
        <h2 class="text-xl font-semibold text-zinc-50">Install</h2>
        <p class="mt-2 text-sm text-zinc-400">
          <code class="rounded bg-zinc-900 px-1 py-0.5">emisar pack install</code>
          fetches this pack, re-validates it, and verifies its content hash against the
          <code class="rounded bg-zinc-900 px-1 py-0.5">--hash</code>
          below — the exact bytes this page was rendered against, so a tampered copy is
          rejected — before copying it into the runner's packs dir. The command reloads a
          running daemon itself; no manual restart.
        </p>
        <div class="mt-4 overflow-hidden rounded-lg border border-zinc-800 bg-black/60">
          <div class="flex items-center justify-between gap-2 border-b border-zinc-800 px-4 py-2">
            <span class="font-mono text-[11px] text-zinc-400">on the runner host</span>
            <EmisarWeb.CoreComponents.copy_button
              id={"copy-install-#{@pack.id}"}
              target={"#install-snippet-#{@pack.id}"}
            >
              Copy
            </EmisarWeb.CoreComponents.copy_button>
          </div>
          <pre
            id={"install-snippet-#{@pack.id}"}
            class="overflow-x-auto p-4 font-mono text-xs leading-relaxed text-zinc-200"
          ><%= EmisarWeb.PacksRegistry.install_snippet(@pack) %></pre>
        </div>
      </section>

      <%!-- Setup — the pack's OWN authored block, carried through catalog.json,
           so this page and `emisar pack info` on the host cannot disagree. --%>
      <section class="mt-12">
        <h2 class="text-xl font-semibold text-zinc-50">Setup</h2>

        <p
          :if={@pack.setup.summary}
          class="mt-2 max-w-prose text-sm leading-relaxed text-zinc-400"
        >
          <.setup_text text={@pack.setup.summary} />
        </p>
        <p
          :if={
            is_nil(@pack.setup.summary) and @pack.setup.env == [] and
              @pack.setup.host_access == []
          }
          class="mt-2 max-w-prose text-sm leading-relaxed text-zinc-400"
        >
          No credentials needed — this pack acts on the runner host itself.
        </p>

        <%!-- Credentials. A required variable is an action the operator must take
             before the pack works, so it carries the amber marker; an optional one
             with a default is informative and stays neutral. --%>
        <div :if={@pack.setup.env != []} class="mt-5">
          <h3 class="text-sm font-semibold text-zinc-200">Environment</h3>
          <p class="mt-1 text-sm leading-relaxed text-zinc-400">
            Set these on the runner host, then add each name to
            <code class="rounded bg-zinc-900 px-1 py-0.5 font-mono text-xs text-zinc-300">execution.inherit_env</code>
            so the value reaches the action.
          </p>
          <ul class="mt-3 overflow-hidden rounded-xl border border-zinc-900 bg-zinc-950/40">
            <li
              :for={env <- @pack.setup.env}
              class="border-b border-zinc-900 px-5 py-4 last:border-b-0"
            >
              <div class="flex flex-wrap items-center gap-2">
                <code class="font-mono text-sm text-zinc-100">{env.name}</code>
                <span
                  :if={env.required}
                  class="rounded bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-medium text-amber-200"
                >
                  required
                </span>
                <span
                  :if={env.default}
                  class="rounded bg-zinc-800/80 px-1.5 py-0.5 font-mono text-[10px] text-zinc-300"
                >
                  default {env.default}
                </span>
              </div>
              <p
                :if={env.description}
                class="mt-1 max-w-prose text-xs leading-relaxed text-zinc-400"
              >
                <.setup_text text={env.description} />
              </p>
            </li>
          </ul>
        </div>

        <div :if={@pack.setup.host_access != []} class="mt-6">
          <h3 class="text-sm font-semibold text-zinc-200">Host access</h3>
          <p class="mt-1 max-w-prose text-sm leading-relaxed text-zinc-400">
            Run these commands yourself on the runner host. Emisar shows and copies setup
            recipes; it never runs them.
          </p>

          <div class="mt-3 space-y-4">
            <article
              :for={{access, access_index} <- Enum.with_index(@pack.setup.host_access)}
              class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950/40"
            >
              <div class="px-5 py-4">
                <p class="max-w-prose text-sm font-medium leading-relaxed text-zinc-200">
                  <.setup_text text={access.requirement} />
                </p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  <code
                    :for={action_id <- access.actions}
                    class="rounded-md border border-zinc-800 bg-zinc-900/70 px-2 py-1 font-mono text-[11px] text-zinc-300"
                  >{action_id}</code>
                </div>
              </div>

              <div
                :for={{recipe, recipe_index} <- Enum.with_index(access.recipes)}
                class="space-y-3 border-t border-zinc-800 px-5 py-4"
              >
                <h4 class="text-xs font-semibold uppercase tracking-wide text-zinc-400">
                  <.setup_text text={recipe.name} />
                </h4>
                <.setup_command_block
                  id={"host-access-#{@pack.id}-#{access_index}-#{recipe_index}-commands"}
                  label="Grant access"
                  commands={recipe.commands}
                />
                <.setup_command_block
                  id={"host-access-#{@pack.id}-#{access_index}-#{recipe_index}-verify"}
                  label="Verify access"
                  commands={recipe.verify}
                />
                <p class="text-xs leading-relaxed text-zinc-400">
                  <span class="font-medium text-zinc-300">Impact:</span>
                  <.setup_text text={recipe.impact} />
                </p>
              </div>
            </article>
          </div>
        </div>

        <div :if={@pack.setup.notes != []} class="mt-5">
          <h3 class="text-sm font-semibold text-zinc-200">Notes</h3>
          <ul class="mt-2 max-w-prose list-disc space-y-2 pl-5 text-sm leading-relaxed text-zinc-400">
            <li :for={note <- @pack.setup.notes}><.setup_text text={note} /></li>
          </ul>
        </div>

        <%!-- The pack author's own proof that auth and reachability work. --%>
        <div :if={@pack.setup.verify} class="mt-5">
          <h3 class="text-sm font-semibold text-zinc-200">Verify it works</h3>
          <p class="mt-1 max-w-prose text-sm leading-relaxed text-zinc-400">
            Runs <code class="font-mono text-zinc-300">{@pack.setup.verify}</code>, a low-risk
            read that confirms the pack can reach its target. Run it on the host once the pack
            is installed; <code class="font-mono text-zinc-300">pack install</code> runs it for
            you.
          </p>
          <div class="mt-3 overflow-hidden rounded-lg border border-zinc-800 bg-black/60">
            <div class="flex items-center justify-between gap-2 border-b border-zinc-800 px-4 py-2">
              <span class="font-mono text-[11px] text-zinc-400">on the runner host</span>
              <EmisarWeb.CoreComponents.copy_button
                id={"copy-verify-#{@pack.id}"}
                target={"#verify-snippet-#{@pack.id}"}
              >
                Copy
              </EmisarWeb.CoreComponents.copy_button>
            </div>
            <pre
              id={"verify-snippet-#{@pack.id}"}
              class="overflow-x-auto p-4 font-mono text-xs leading-relaxed text-zinc-200"
            >sudo emisar pack verify <%= @pack.id %></pre>
          </div>
        </div>

        <p class="mt-5 text-sm leading-relaxed text-zinc-400">
          <.link
            navigate={~p"/docs/use-a-published-pack"}
            class="text-brand-400 hover:text-brand-300"
          >Install and configure a pack</.link>
          walks through the whole sequence on a host.
        </p>
      </section>

      <%!-- Actions list — one row per action with link to source --%>
      <section class="mt-12">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-xl font-semibold text-zinc-50">
            Actions
            <span class="ml-1 text-sm font-normal text-zinc-400">
              {length(@pack.actions)} total
            </span>
          </h2>
          <.external_link
            href={EmisarWeb.PacksRegistry.source_url(@pack)}
            class="text-xs text-zinc-400 hover:text-zinc-300"
          >
            View on GitHub
          </.external_link>
        </div>

        <%!-- Each action expands to the pack author's operator docs — the
             description + side effects are server-rendered inside native
             <details> (crawlable while collapsed, no JS), which is what gives
             this page real reference weight instead of a bare id list. --%>
        <ul class="mt-4 overflow-hidden rounded-xl border border-zinc-900 bg-zinc-950/40">
          <li :for={action <- @pack.actions} class="border-b border-zinc-900 last:border-b-0">
            <details class="group">
              <summary class="flex cursor-pointer items-center gap-4 px-5 py-4 transition-colors hover:bg-zinc-900/30">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-zinc-900 text-zinc-400">
                  <.icon name={action_icon(action.kind)} class="h-4 w-4" />
                </span>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="truncate font-mono text-sm text-zinc-100">{action.id}</span>
                    <span class="rounded bg-zinc-800/80 px-1.5 py-0.5 text-[10px] font-medium text-zinc-300">
                      {action.kind}
                    </span>
                    <.risk_pill id={"pack-action-#{action.id}-risk"} risk={action.risk} />
                  </div>
                  <p class="mt-0.5 truncate text-xs text-zinc-400">{action.title}</p>
                </div>

                <.icon
                  name="action.disclose"
                  class="h-4 w-4 shrink-0 text-zinc-500 transition duration-200 group-hover:text-zinc-400 group-open:rotate-180"
                />
              </summary>

              <div class="space-y-3 px-5 pb-5 sm:pl-[4.5rem]">
                <p
                  :if={action.description != ""}
                  class="max-w-prose text-sm leading-relaxed text-zinc-400"
                >
                  {action.description}
                </p>
                <.external_link
                  href={EmisarWeb.PacksRegistry.action_source_url(@pack, action)}
                  class="inline-flex text-xs text-zinc-400 hover:text-zinc-300"
                >
                  View source on GitHub
                </.external_link>
              </div>
            </details>
          </li>
        </ul>
      </section>

      <%!-- Footer CTAs --%>
      <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-900 pt-6 text-sm">
        <.link
          navigate={~p"/packs"}
          class="text-zinc-400 hover:text-zinc-200"
        >
          ← Back to registry
        </.link>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <.cta_link
            navigate={~p"/docs/action-packs"}
            class="inline-block min-h-10 py-2.5"
          >Pack reference</.cta_link>
          <.link
            navigate={~p"/docs/publishing-packs"}
            class="group inline-block min-h-10 py-2.5 font-semibold text-brand-300 hover:text-brand-200"
          >Publish your own&nbsp;<.cta_arrow /></.link>
        </div>
      </div>
    </div>
  </section>

  <.marketing_footer />
</div>
