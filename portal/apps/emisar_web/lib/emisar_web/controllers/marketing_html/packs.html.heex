<%!-- ============================================================
  Packs registry — browseable index of every published pack
============================================================ --%>

<div class="bg-zinc-950 text-zinc-100">
  <.marketing_nav signed_in?={@signed_in?} current={:packs} />

  <%!-- Hero --%>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <p class="text-base font-semibold text-brand-400">Registry</p>
      <.marketing_heading tag="h1" scale={:display} class="mt-2">
        Action packs
      </.marketing_heading>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-zinc-400 text-pretty">
        Browse {@pack_count} packs with {@action_count} actions for the software you run.
        Each pack shows what it can do, which credentials and permissions it needs, and how
        to install it. Start with the <.link
          navigate={~p"/docs/use-a-published-pack"}
          class="text-brand-300 hover:text-brand-200"
        >pack installation guide</.link>, or <.link
          href={~p"/docs/publishing-packs"}
          class="text-brand-300 hover:text-brand-200"
        >author your own</.link>.
      </p>
    </div>
  </section>

  <%!-- Search + category jump-nav. Search filters cards client-side (a no-op
       without JS — the full list stays server-rendered for crawlers); the
       pills are crawlable anchors into each category section. --%>
  <section class="border-y border-zinc-900 bg-zinc-950/40">
    <div class="mx-auto max-w-5xl space-y-4 px-6 py-5 lg:px-8">
      <div class="relative max-w-md">
        <.icon
          name="action.search"
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-400"
        />
        <input
          id="pack-search"
          type="search"
          autocomplete="off"
          aria-label={"Search #{@pack_count} action packs"}
          placeholder="Search by tool or task — postgres, replication lag…"
          class="w-full rounded-lg border-0 bg-zinc-900/80 py-2 pl-9 pr-3 text-sm text-zinc-100 ring-1 ring-zinc-800 placeholder:text-zinc-400 focus:ring-2 focus:ring-brand-500"
        />
      </div>
      <nav class="flex flex-wrap gap-2" aria-label="Pack categories">
        <a
          :for={{label, slug, packs} <- @grouped}
          href={"##{slug}"}
          data-pack-nav={slug}
          class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-950/60 px-3 py-1 text-xs font-medium text-zinc-400 transition hover:border-brand-500/40 hover:text-brand-200"
        >
          {label}
          <span data-pack-nav-count class="text-zinc-400">{length(packs)}</span>
        </a>
      </nav>
    </div>
  </section>

  <%!-- Packs by category --%>
  <section class="pb-24 sm:pb-32">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div
        :for={{label, slug, packs} <- @grouped}
        id={slug}
        data-pack-section
        class="scroll-mt-6 pt-14 first:pt-12"
      >
        <h2 class="flex items-center gap-3 text-xl font-semibold text-zinc-100">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
            <.icon name={category_icon(slug)} class="h-4 w-4" />
          </span>
          {label}
          <span data-pack-count={length(packs)} class="text-sm font-normal text-zinc-400">
            {length(packs)}
          </span>
        </h2>
        <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
          <article
            :for={pack <- packs}
            data-pack-name={EmisarWeb.PacksRegistry.search_terms(pack)}
            class="group relative flex flex-col rounded-2xl border border-zinc-900 bg-zinc-950/60 p-6 transition hover:border-brand-500/40"
          >
            <header class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-lg font-semibold text-zinc-50">
                  <.link
                    navigate={~p"/packs/#{pack.id}"}
                    class="hover:text-brand-300"
                  >
                    {pack.name}
                  </.link>
                </h3>
                <p class="mt-1 truncate font-mono text-xs text-zinc-400">
                  {pack.id} · v{pack.version} · {pack.vendor}
                </p>
              </div>
              <span class="shrink-0 rounded-full bg-brand-500/10 px-2 py-1 text-[10px] font-medium text-brand-300 ring-1 ring-brand-500/30">
                {length(pack.actions)} {if length(pack.actions) == 1,
                  do: "action",
                  else: "actions"}
              </span>
            </header>

            <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">
              {pack.description}
            </p>

            <%!-- Requirements row — chips for OS / required binaries. --%>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span
                :for={os <- pack.requires_os}
                class="rounded-sm bg-zinc-800/80 px-1.5 py-0.5 text-[10px] font-medium text-zinc-300"
              >
                os: {os}
              </span>
              <span
                :for={bin <- pack.requires_binaries}
                class="rounded-sm bg-amber-500/15 px-1.5 py-0.5 text-[10px] font-medium text-amber-200 ring-1 ring-amber-500/30"
              >
                needs: {bin}
              </span>
            </div>

            <div class="mt-5 flex items-center justify-between gap-3 border-t border-zinc-900 pt-4 text-sm">
              <.link
                navigate={~p"/packs/#{pack.id}"}
                class="font-semibold text-brand-300 hover:text-brand-200"
              >Browse pack&nbsp;<.cta_arrow /></.link>
              <.external_link
                href={EmisarWeb.PacksRegistry.source_url(pack)}
                class="text-xs text-zinc-400 hover:text-zinc-300"
              >
                Source
              </.external_link>
            </div>
          </article>
        </div>
      </div>

      <p
        id="pack-search-empty"
        hidden
        role="status"
        aria-live="polite"
        class="mt-12 text-center text-sm text-zinc-400"
      >
        No packs match that search yet. You can
        <.link href={~p"/docs/publishing-packs"} class="text-brand-300 hover:text-brand-200">
          author your own
        </.link>
        or <.link href={EmisarWeb.MailTo.sales()} class="text-brand-300 hover:text-brand-200">ask us to add it</.link>.
      </p>

      <%!-- "Publish your own" CTA card — distinct visual treatment so
           it doesn't get mistaken for another pack. --%>
      <div class="mt-16 rounded-2xl border border-dashed border-zinc-800 bg-zinc-950/40 p-8 text-center">
        <h2 class="text-lg font-semibold text-zinc-100">Author your own pack</h2>
        <p class="mx-auto mt-2 max-w-xl text-sm text-zinc-400">
          Packs are YAML, so you don't need an SDK or a compiler. You can write, install, and
          trust a pack you maintain yourself. The schema reference and the requirements for the
          curated registry are in the docs.
        </p>
        <div class="mt-5 flex items-center justify-center gap-3">
          <.marketing_button navigate={~p"/docs/publishing-packs"} size={:sm}>
            Authoring guide
          </.marketing_button>
          <.marketing_button variant={:secondary} navigate={~p"/docs/action-packs"} size={:sm}>
            YAML reference
          </.marketing_button>
        </div>
        <p class="mx-auto mt-6 max-w-xl text-xs leading-5 text-zinc-400">
          Missing a pack that more teams than yours would use? <.external_link
            href="https://github.com/andrewdryga/emisar/issues/new"
            class="text-brand-300 hover:text-brand-200"
          >
            Open a GitHub issue
          </.external_link>. We'd rather add it to the catalog once than have every team write its
          own.
        </p>
      </div>
    </div>
  </section>

  <.marketing_footer />
</div>
