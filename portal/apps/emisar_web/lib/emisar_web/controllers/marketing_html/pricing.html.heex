<%!-- ============================================================
  Pricing — three tiers + FAQ
============================================================ --%>

<div class="bg-zinc-950 text-zinc-100">
  <.marketing_nav current_user={@current_user} current={:pricing} />

  <%!-- Hero --%>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <.marketing_heading tag="h1" scale={:display}>
          Per runner, not per seat.
        </.marketing_heading>
        <p class="mt-4 text-sm text-zinc-400">
          At this price, one prevented 2&nbsp;a.m. rollback pays for the year. <.link
            navigate={~p"/use-cases"}
            class="font-medium text-brand-400 hover:text-brand-300"
          >See what that looks like</.link>.
        </p>
      </div>

      <%!-- Monthly/annual toggle — plain-JS class swap (initPricingCycle), the
           marketing bundle ships no LiveSocket. Only the Team card carries a
           paid annual price; Free ($0) and Enterprise (Custom) don't change. --%>
      <div class="mt-12 flex justify-center">
        <div
          data-cycle-toggle
          class="inline-flex rounded-lg p-0.5 text-sm font-medium ring-1 ring-zinc-800"
        >
          <button
            type="button"
            data-cycle="month"
            aria-pressed="true"
            class="rounded-md bg-zinc-800 px-4 py-1.5 text-zinc-100 transition-colors"
          >
            Monthly
          </button>
          <button
            type="button"
            data-cycle="year"
            aria-pressed="false"
            class="rounded-md px-4 py-1.5 text-zinc-400 transition-colors hover:text-zinc-200"
          >
            Annual
            <span :if={@team_annual_savings} class="text-brand-400">
              · {@team_annual_savings}
            </span>
          </button>
        </div>
      </div>

      <%!-- Tiers --%>
      <div class="mx-auto mt-10 grid max-w-5xl grid-cols-1 gap-6 lg:max-w-none lg:grid-cols-3 lg:gap-8">
        <%!-- Free --%>
        <div data-plan="free" class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-8">
          <h2 class="text-lg font-semibold text-zinc-50">{@free_plan.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">For evaluation and solo use.</p>
          <p class="mt-6 flex items-baseline gap-x-1">
            <span class="text-5xl font-bold tracking-tight text-zinc-50">${@free_price}</span>
            <span class="text-sm font-semibold text-zinc-400">/ forever</span>
          </p>
          <.marketing_button
            variant={:secondary}
            href={~p"/sign_up"}
            size={:lg}
            block
            class="mt-8"
          >
            Start free
          </.marketing_button>
          <ul data-plan-features="free" class="mt-8 space-y-3 text-sm text-zinc-300">
            <li :for={{_id, feature} <- @free_plan.features} class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-zinc-500" />
              {feature}
            </li>
            <%!-- Policy is available on every plan; it is product-wide marketing copy,
                 not a Billing entitlement. --%>
            <li class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-zinc-500" />
              All policy features
            </li>
          </ul>
        </div>

        <%!-- Team --%>
        <div
          data-plan="team"
          class="relative rounded-2xl border-2 border-brand-500 bg-zinc-950/80 p-8 shadow-2xl shadow-brand-900/30"
        >
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-500 px-4 py-1 text-xs font-semibold text-zinc-950">
            Most popular
          </span>
          <h2 class="text-lg font-semibold text-brand-300">{@team_plan.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">For production teams.</p>
          <p class="mt-6 flex items-baseline gap-x-1" data-cycle-price="month">
            <span class="text-5xl font-bold tracking-tight text-zinc-50">
              ${@team_monthly_price}
            </span>
            <span class="text-sm font-semibold text-zinc-400">/ runner / mo</span>
          </p>
          <p class="mt-6 flex hidden items-baseline gap-x-1" data-cycle-price="year">
            <span class="text-5xl font-bold tracking-tight text-zinc-50">
              ${@team_annual_price}
            </span>
            <span class="text-sm font-semibold text-zinc-400">/ runner / yr</span>
          </p>
          <.marketing_button
            href={@team_intent_paths.month}
            data-cycle-intent-link
            data-cycle-href-month={@team_intent_paths.month}
            data-cycle-href-year={@team_intent_paths.year}
            size={:lg}
            block
            class="mt-8"
          >
            Continue with Team
          </.marketing_button>
          <ul data-plan-features="team" class="mt-8 space-y-3 text-sm text-zinc-300">
            <li class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-brand-400" />
              Up to {@team_plan.runners_limit} runners
            </li>
            <li :for={{_id, feature} <- @team_plan.features} class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-brand-400" />
              {feature}
            </li>
            <%!-- Availability and invoicing are commercial promises, not feature gates. --%>
            <li class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-brand-400" />
              99.95% uptime target
            </li>
            <li class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-brand-400" />
              Automated invoices
            </li>
          </ul>
        </div>

        <%!-- Enterprise --%>
        <div
          data-plan="enterprise"
          class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-8"
        >
          <h2 class="text-lg font-semibold text-zinc-50">{@enterprise_plan.name}</h2>
          <p class="mt-2 text-sm text-zinc-400">For design partners and regulated teams.</p>
          <p class="mt-6 flex items-baseline gap-x-1">
            <span class="text-5xl font-bold tracking-tight text-zinc-50">
              {@enterprise_price}
            </span>
          </p>
          <.marketing_button
            variant={:secondary}
            href={EmisarWeb.MailTo.sales()}
            size={:lg}
            block
            class="mt-8"
          >
            Talk to sales
          </.marketing_button>
          <p class="mt-3 text-center text-sm">
            <a
              href="https://cal.com/andrew-dryga/emisar"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-brand-400 hover:text-brand-300"
            >
              or book a 30-minute demo &rarr;
            </a>
          </p>
          <ul data-plan-features="enterprise" class="mt-8 space-y-3 text-sm text-zinc-300">
            <li class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-zinc-500" />
              <%= if @enterprise_plan.runners_limit == :unlimited and @enterprise_plan.members_limit == :unlimited do %>
                Unlimited runners and users
              <% else %>
                {@enterprise_plan.runners_limit} runners and {@enterprise_plan.members_limit} users
              <% end %>
            </li>
            <li
              :for={{_id, feature} <- @enterprise_plan.features}
              class="flex items-start gap-3"
            >
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-zinc-500" />
              {feature}
            </li>
            <%!-- The SLA and contract terms are negotiated promises, not entitlements. --%>
            <li class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-zinc-500" />
              99.99% uptime SLA
            </li>
            <li class="flex items-start gap-3">
              <.icon name="state.included" class="mt-0.5 h-5 w-5 flex-none text-zinc-500" />
              Custom commercial terms
            </li>
          </ul>
          <p class="mt-6 text-sm">
            <.cta_link navigate={~p"/trust"}>See the full trust &amp; compliance posture</.cta_link>
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- How it works — answers "how hard is adoption?" right at the decision point --%>
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold text-brand-400">Up and running in minutes</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl text-balance">
          From sign-up to your first audited action
        </h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-6">
          <div class="text-xs font-semibold uppercase tracking-wider text-brand-400">Step 1</div>
          <h3 class="mt-2 text-base font-semibold text-zinc-100">Create an account</h3>
          <p class="mt-2 text-sm leading-6 text-zinc-400">
            Free, no credit card. You're in the console in under a minute.
          </p>
        </div>
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-6">
          <div class="text-xs font-semibold uppercase tracking-wider text-brand-400">Step 2</div>
          <h3 class="mt-2 text-base font-semibold text-zinc-100">Install a runner</h3>
          <p class="mt-2 text-sm leading-6 text-zinc-400">
            One command on a Linux or macOS host — the console hands you the install
            one-liner and watches it connect.
          </p>
        </div>
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-6">
          <div class="text-xs font-semibold uppercase tracking-wider text-brand-400">Step 3</div>
          <h3 class="mt-2 text-base font-semibold text-zinc-100">Run an action</h3>
          <p class="mt-2 text-sm leading-6 text-zinc-400">
            Dispatch from the console, or point Claude, ChatGPT, or Cursor at your
            account's MCP endpoint — and let policy decide.
          </p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <.cta_link navigate={~p"/docs/quickstart"} class="text-sm">Read the quickstart</.cta_link>
      </div>
    </div>
  </section>

  <%!-- Comparison table --%>
  <section
    id="compare"
    class="scroll-mt-24 border-y border-zinc-900 bg-zinc-950/40 py-24 sm:py-32"
  >
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <.marketing_heading tag="h2" scale={:section}>
          Compare plans
        </.marketing_heading>
      </div>
      <div class="mx-auto mt-12 max-w-5xl overflow-x-auto rounded-2xl border border-zinc-900">
        <table class="w-full min-w-[720px] divide-y divide-zinc-900 text-sm">
          <thead class="bg-zinc-950/80">
            <tr>
              <th scope="col" class="px-6 py-4 text-left font-semibold text-zinc-300">Feature</th>
              <th scope="col" class="px-6 py-4 text-left font-semibold text-zinc-300">
                {@free_plan.name}
              </th>
              <th scope="col" class="px-6 py-4 text-left font-semibold text-brand-300">
                {@team_plan.name}
              </th>
              <th scope="col" class="px-6 py-4 text-left font-semibold text-zinc-300">
                {@enterprise_plan.name}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-900 bg-zinc-950/40">
            <tr data-feature="runners">
              <td class="px-6 py-4 font-medium text-zinc-100">Runners</td>
              <td class="px-6 py-4 text-zinc-400">{@free_plan.runners_limit}</td>
              <td class="px-6 py-4 text-zinc-400">{@team_plan.runners_limit}</td>
              <td class="px-6 py-4 text-zinc-400">
                {if @enterprise_plan.runners_limit == :unlimited,
                  do: "Unlimited",
                  else: @enterprise_plan.runners_limit}
              </td>
            </tr>
            <tr data-feature="users">
              <td class="px-6 py-4 font-medium text-zinc-100">Users</td>
              <td class="px-6 py-4 text-zinc-400">{@free_plan.members_limit}</td>
              <td class="px-6 py-4 text-zinc-400">
                {if @team_plan.members_limit == :unlimited,
                  do: "Unlimited",
                  else: @team_plan.members_limit}
              </td>
              <td class="px-6 py-4 text-zinc-400">
                {if @enterprise_plan.members_limit == :unlimited,
                  do: "Unlimited",
                  else: @enterprise_plan.members_limit}
              </td>
            </tr>
            <tr data-feature="audit-retention">
              <td class="px-6 py-4 font-medium text-zinc-100">Audit retention</td>
              <td class="px-6 py-4 text-zinc-400">{@free_plan.audit_retention_days} days</td>
              <td class="px-6 py-4 text-zinc-400">{@team_plan.audit_retention_days} days</td>
              <td class="px-6 py-4 text-zinc-400">
                {@enterprise_plan.audit_retention_days} days
              </td>
            </tr>
            <tr data-feature="policy">
              <td class="px-6 py-4 font-medium text-zinc-100">Policy + approvals</td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
            </tr>
            <tr data-feature="mcp">
              <td class="px-6 py-4 font-medium text-zinc-100">MCP server</td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
            </tr>
            <tr data-feature="pack-trust">
              <td class="px-6 py-4 font-medium text-zinc-100">Pack trust + drift blocking</td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
              <td class="px-6 py-4 text-zinc-400">
                <.icon name="state.included" class="h-5 w-5 text-brand-400" />
              </td>
            </tr>
            <tr data-feature="audit-export">
              <td class="px-6 py-4 font-medium text-zinc-100">SIEM export</td>
              <td data-plan="free" class="px-6 py-4 text-zinc-500">
                <.plan_feature_availability included={@comparison["free"].audit_export} />
              </td>
              <td data-plan="team" class="px-6 py-4 text-zinc-400">
                <.plan_feature_availability included={@comparison["team"].audit_export} />
              </td>
              <td data-plan="enterprise" class="px-6 py-4 text-zinc-400">
                <.plan_feature_availability included={@comparison["enterprise"].audit_export} />
              </td>
            </tr>
            <tr data-feature="sso">
              <td class="px-6 py-4 font-medium text-zinc-100">Single sign-on (OIDC)</td>
              <td data-plan="free" class="px-6 py-4 text-zinc-500">
                <.plan_feature_availability included={@comparison["free"].sso} />
              </td>
              <td data-plan="team" class="px-6 py-4 text-zinc-400">
                <.plan_feature_availability included={@comparison["team"].sso} />
              </td>
              <td data-plan="enterprise" class="px-6 py-4 text-zinc-400">
                <.plan_feature_availability included={@comparison["enterprise"].sso} />
              </td>
            </tr>
            <tr data-feature="scim">
              <td class="px-6 py-4 font-medium text-zinc-100">SCIM directory sync</td>
              <td data-plan="free" class="px-6 py-4 text-zinc-500">
                <.plan_feature_availability included={@comparison["free"].scim} />
              </td>
              <td data-plan="team" class="px-6 py-4 text-zinc-500">
                <.plan_feature_availability included={@comparison["team"].scim} />
              </td>
              <td data-plan="enterprise" class="px-6 py-4 text-zinc-400">
                <.plan_feature_availability included={@comparison["enterprise"].scim} />
              </td>
            </tr>
            <tr data-feature="uptime">
              <td class="px-6 py-4 font-medium text-zinc-100">Uptime</td>
              <td class="px-6 py-4 text-zinc-500">—</td>
              <td class="px-6 py-4 text-zinc-400">99.95% target</td>
              <td class="px-6 py-4 text-zinc-400">99.99% SLA</td>
            </tr>
            <tr data-feature="deployment">
              <td class="px-6 py-4 font-medium text-zinc-100">Deployment planning</td>
              <td data-plan="free" class="px-6 py-4 text-zinc-500">
                {@comparison["free"].deployment || "—"}
              </td>
              <td data-plan="team" class="px-6 py-4 text-zinc-500">
                {@comparison["team"].deployment || "—"}
              </td>
              <td data-plan="enterprise" class="px-6 py-4 text-zinc-400">
                {@comparison["enterprise"].deployment || "—"}
              </td>
            </tr>
            <tr data-feature="support">
              <td class="px-6 py-4 font-medium text-zinc-100">Support</td>
              <td data-plan="free" class="px-6 py-4 text-zinc-400">
                {@comparison["free"].support || "—"}
              </td>
              <td data-plan="team" class="px-6 py-4 text-zinc-400">
                {@comparison["team"].support || "—"}
              </td>
              <td data-plan="enterprise" class="px-6 py-4 text-zinc-400">
                {@comparison["enterprise"].support || "—"}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%!-- FAQ --%>
  <section data-pricing-faqs class="py-24 sm:py-32">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <.marketing_heading tag="h2" scale={:section}>
        Frequently asked questions
      </.marketing_heading>
      <div class="mt-12 divide-y divide-zinc-900 overflow-hidden rounded-2xl border border-zinc-900 bg-zinc-950/60">
        <%= for {q, a} <- @faqs do %>
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between transition-colors hover:bg-zinc-900/30 px-8 py-6 text-base font-semibold text-zinc-50">
              {q}
              <.icon
                name="action.disclose"
                class="h-5 w-5 shrink-0 text-zinc-500 transition duration-200 group-hover:text-zinc-300 group-open:rotate-180 group-open:text-brand-400"
              />
            </summary>
            <p class="px-8 pb-6 text-sm leading-6 text-zinc-400">{a}</p>
          </details>
        <% end %>
      </div>
      <p class="mt-8 text-sm text-zinc-400">
        More on how we handle data, secrets, and audit on the <.link
          navigate={~p"/security"}
          class="text-brand-400 hover:text-brand-300"
        >security page</.link>, and how billing and cancellations work in our <.link
          navigate={~p"/refund-policy"}
          class="text-brand-400 hover:text-brand-300"
        >refund policy</.link>.
      </p>
    </div>
  </section>

  <.marketing_footer />
</div>
