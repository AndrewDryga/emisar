<div class="bg-zinc-950 text-zinc-100">
  <.marketing_nav current_user={@current_user} current={:docs} />

  <section class="py-12 sm:py-16">
    <.docs_layout
      current="connect-chatgpt"
      updated="September 6, 2026"
      toc={[
        {"connect", "Add the connector"},
        {"verify", "Verify the connection"},
        {"sign-in-grants", "What the sign-in grants"}
      ]}
    >
      <.docs_header current="connect-chatgpt">
        <:dek>
          Connect ChatGPT to emisar through Developer mode over remote MCP. OAuth signs you in —
          you do not need to copy an agent key.
        </:dek>
      </.docs_header>

      <.docs_cloud_connector_pointer
        sibling_label="Claude.ai"
        sibling_path={~p"/docs/connect-claude-ai"}
      />

      <.docs_cloud_connector_prerequisites />

      <.docs_h2 id="connect">Add the connector</.docs_h2>
      <p class="mt-4 text-base text-zinc-400">
        ChatGPT reaches a custom MCP server through <strong>Developer mode</strong>. Access depends
        on your account and workspace policy.
      </p>
      <ol class="mt-4 list-decimal space-y-3 pl-6 text-base text-zinc-300">
        <li>
          Open
          <a
            href={~p"/app/agents/connect"}
            class="font-medium text-brand-300 underline decoration-brand-500/30 underline-offset-4 hover:text-brand-200"
          >Connect an agent</a>
          in emisar and select <strong>ChatGPT</strong>.
        </li>
        <li>
          In ChatGPT, open <strong>Settings</strong>
          and select <strong>Security and login</strong>.
        </li>
        <li>
          Turn on <strong>Developer mode</strong>. If the option is missing, check your account's
          eligibility or ask your workspace admin about access.
        </li>
        <li>
          Open
          <a
            href="https://chatgpt.com/plugins"
            class="text-brand-400 hover:text-brand-300"
          >ChatGPT Plugins</a>
          and select <strong>+</strong>
          next to the search box.
        </li>
        <li>
          Fill the form:
          <ul class="mt-1 list-disc space-y-1 pl-6 text-zinc-400">
            <li><strong>Name</strong> — paste the name below</li>
            <li>
              <strong>Description</strong> (optional) — "Run approved
              infrastructure actions on my fleet."
            </li>
            <li>
              <strong>Connection</strong> → <strong>Server URL</strong> — paste the URL below
            </li>
            <li>
              <strong>Authentication</strong> — choose <strong>OAuth</strong>. There is no client
              ID or secret to paste; emisar registers the connector itself.
            </li>
          </ul>
          <.docs_value label="Name" copy_text="emisar">emisar</.docs_value>
          <.docs_value label="Remote MCP server URL" copy_text="https://emisar.dev/api/mcp/rpc">
            https://emisar.dev/api/mcp/rpc
          </.docs_value>
          <p class="mt-3">
            Select <strong>Create</strong>, then review the discovered tools and metadata.
          </p>
        </li>
        <li>
          ChatGPT opens the emisar sign-in page. Sign in, review the requested access, and
          choose <strong>Authorize</strong>. ChatGPT then lists the emisar tools.
        </li>
        <li>
          Review the connection permissions. emisar policy, approvals, and audit still apply to
          every call.
        </li>
        <li>
          Start a new chat. Add <strong>emisar</strong>
          from the tools menu. A listed tool means metadata access only. Adding the connection
          lets the chat call those tools.
        </li>
      </ol>
      <p class="mt-4 text-base text-zinc-400">
        If emisar's tools change, open its connection in ChatGPT Plugins and select
        <strong>Refresh</strong>
        before starting a new chat. <.link
          href="https://developers.openai.com/plugins/deploy/connect-chatgpt"
          class="text-brand-400 hover:text-brand-300"
        >ChatGPT connection guide</.link>.
      </p>
      <.docs_cloud_connector_verify />

      <.docs_cloud_connector_grants />
    </.docs_layout>
  </section>

  <.marketing_cta
    headline="Point your agent at real infrastructure — safely."
    subcopy="Set up a runner first, then connect ChatGPT to your account's MCP endpoint and let policy decide what runs."
    secondary_label="Read the quickstart"
    secondary_path={~p"/docs/quickstart"}
  />

  <.marketing_footer />
</div>
