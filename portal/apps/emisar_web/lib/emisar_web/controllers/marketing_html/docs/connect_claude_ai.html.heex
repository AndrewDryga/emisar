<div class="bg-zinc-950 text-zinc-100">
  <.marketing_nav current_user={@current_user} current={:docs} />

  <section class="py-12 sm:py-16">
    <.docs_layout
      current="connect-claude-ai"
      updated="August 21, 2026"
      toc={[
        {"connect", "Add the connector"},
        {"verify", "Verify the connection"},
        {"sign-in-grants", "What the sign-in grants"}
      ]}
    >
      <.docs_header current="connect-claude-ai">
        <:dek>
          Connect Claude.ai to emisar over remote MCP. OAuth signs you in — you do not need to
          copy an agent key.
        </:dek>
      </.docs_header>

      <.docs_cloud_connector_pointer
        sibling_label="ChatGPT"
        sibling_path={~p"/docs/connect-chatgpt"}
      />

      <.docs_cloud_connector_prerequisites />

      <.docs_h2 id="connect">Add the connector</.docs_h2>
      <ol class="mt-4 list-decimal space-y-3 pl-6 text-base text-zinc-300">
        <li>
          Open <strong>Settings → Connectors</strong>
          (on Pro/Max it is <strong>Customize → Connectors</strong>).
        </li>
        <li>
          Click <strong>+</strong> → <strong>Add custom connector</strong>.
        </li>
        <li>
          Fill in the <strong>Connector name</strong>
          and the URL field:
          <.docs_value label="Connector name" copy_text="emisar">emisar</.docs_value>
          <.docs_value label="Remote MCP server URL" copy_text="https://emisar.dev/api/mcp/rpc">
            https://emisar.dev/api/mcp/rpc
          </.docs_value>
        </li>
        <li>
          Leave <strong>Advanced settings</strong>
          (OAuth Client ID / Client Secret) <strong>empty</strong>
          —
          emisar registers your client for you via Dynamic Client
          Registration. Click <strong>Add</strong>.
        </li>
        <li>
          Claude opens an emisar tab. Sign in, review what the
          connector is asking for, and click <strong>Authorize</strong>. The connector flips on.
        </li>
        <li>
          Optional. Open <strong>Settings → Connectors → emisar</strong>. Under <strong>Tool permissions</strong>, set both
          <strong>Read-only tools</strong>
          and <strong>Write/delete tools</strong>
          to <strong>Always allow</strong>. This removes Claude's own per-tool prompts. Emisar policy, approvals, and audit still apply.
        </li>
        <li>
          Turn it on for a chat. The <strong>+</strong> button (lower-left of the composer)
          → <strong>Connectors</strong> → toggle <strong>emisar</strong>.
        </li>
      </ol>
      <.docs_callout kind={:note}>
        <p>
          <strong class="text-zinc-400">On Claude Team or Enterprise:</strong>
          this is a setting in <em>Claude's</em>
          workspace, not emisar. Only a Claude organization owner can add the connector, under <strong>Settings → Organization settings → Connectors → Add → Custom → Web</strong>.
          Everyone else then opens <strong>Customize → Connectors</strong>
          and clicks <strong>Connect</strong>
          to run the same sign-in.
        </p>
      </.docs_callout>

      <.docs_cloud_connector_verify />

      <.docs_cloud_connector_grants />
    </.docs_layout>
  </section>

  <.marketing_cta
    headline="Point your agent at real infrastructure — safely."
    subcopy="Set up a runner first, then connect Claude.ai to your account's MCP endpoint and let policy decide what runs."
    secondary_label="Read the quickstart"
    secondary_path={~p"/docs/quickstart"}
  />

  <.marketing_footer />
</div>
