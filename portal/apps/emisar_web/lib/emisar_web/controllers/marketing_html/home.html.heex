<%!-- ============================================================
  Home — emisar marketing landing
  Give your LLM safe access to production. Without the panic.
============================================================ --%>

<div class="bg-zinc-950 text-zinc-100 antialiased">
  <.marketing_nav signed_in?={@signed_in?} current={:home} sticky />

  <%!-- Hero --%>
  <section class="relative overflow-hidden border-b border-zinc-900 bg-[#07080a]">
    <div class="contract-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="grain pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-7xl px-6 py-12 sm:py-20 lg:px-8">
      <div class="max-w-5xl">
        <.marketing_heading tag="h1" scale={:display} class="rise-1 max-w-4xl">
          The best way to give your AI agents access to production.
        </.marketing_heading>
        <p class="rise-2 mt-6 max-w-2xl text-lg leading-relaxed text-zinc-300">
          A Zero-Trust gateway connecting Claude, Cursor, ChatGPT, and other MCP agents
          to your infrastructure. Give your agents the tools to investigate incidents,
          manage deployments, and handle daily operations. You control what runs,
          what needs approval, and what stays off-limits in one central place for your Team.
        </p>
        <div class="rise-3 mt-8 flex flex-wrap items-center gap-4">
          <.marketing_button href={~p"/sign_up"} icon="action.next">
            Start free
          </.marketing_button>
          <.marketing_button variant={:secondary} href={~p"/docs/quickstart"}>
            Run the quickstart
          </.marketing_button>
        </div>
        <p class="rise-4 mt-6 text-xs text-zinc-400">
          Free for 3 runners &middot; No credit card required &middot;
          <a
            href="https://github.com/andrewdryga/emisar/blob/main/runner/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            class="underline-offset-2 hover:text-zinc-200 hover:underline"
          >
            Apache-2.0 open-source runner &amp; MCP bridge
          </a>
        </p>
      </div>
    </div>
  </section>

  <%!-- Proof strip — no logo wall yet (no on-record customers to show), so the
       trust bar is concrete instead: the catalog's real scale, the framework emisar is built to, the
       audit guarantee, and the open license. Sits on the hero's own dark ground
       (a strip, not an eyebrow→H2 section) so it reads as the hero's footing and
       adds substance above the fold without adding to the page's section rhythm. --%>
  <section class="border-b border-zinc-900 bg-[#07080a]" aria-label="emisar at a glance">
    <div class="mx-auto grid max-w-7xl grid-cols-2 px-6 sm:grid-cols-4 sm:divide-x sm:divide-zinc-900 lg:px-8">
      <div class="border-b border-zinc-900 px-4 py-6 text-center sm:border-b-0 sm:py-7">
        <div class="font-mono text-2xl font-bold tabular-nums text-zinc-50">{@action_count}</div>
        <div class="mt-1 text-xs text-zinc-400">
          available actions &middot; {@pack_count} packs
        </div>
      </div>
      <.link
        navigate={~p"/zero-trust"}
        class="group border-b border-zinc-900 px-4 py-6 text-center sm:border-b-0 sm:py-7"
      >
        <div class="text-base font-semibold text-zinc-100 transition group-hover:text-brand-300">
          Zero-Trust for AI
        </div>
        <div class="mt-1 text-xs text-zinc-400">built to Anthropic's control set</div>
      </.link>
      <div class="px-4 py-6 text-center sm:py-7">
        <div class="text-base font-semibold text-zinc-100">Audit logged</div>
        <div class="mt-1 text-xs text-zinc-400">plus a hash-chained journal on each host</div>
      </div>
      <a
        href="https://github.com/andrewdryga/emisar/blob/main/LICENSE.md"
        target="_blank"
        rel="noopener noreferrer"
        class="group px-4 py-6 text-center sm:py-7"
      >
        <div class="text-base font-semibold text-zinc-100 transition group-hover:text-brand-300">
          Open code
        </div>
        <div class="mt-1 text-xs text-zinc-400">
          Apache-2.0 runner and MCP bridge.
        </div>
      </a>
    </div>
  </section>

  <%!-- "Your AI is brilliant. And blind." — the canonical "what your agent
       gains with production access" section: the brilliant-and-blind framing,
       the read-everything breadth, and the act-only-behind-approval line.
       Shaded: it takes the alternation slot the removed pain section held —
       the alternatives argument now lives with the comparison table below. --%>
  <section class="border-y border-zinc-900 bg-zinc-950/40 py-24 sm:py-32">
    <div data-reveal class="mx-auto max-w-7xl px-6 lg:px-8">
      <%!-- Asymmetric layout (left pitch / right capability list), deliberately
           NOT the centered card-grid the page uses elsewhere — it gives the top
           of the page movement and its own distinct shape. --%>
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <p class="text-base font-semibold text-brand-400">With eyes on production</p>
          <.marketing_heading tag="h2" scale={:section} class="mt-2">
            Your AI is brilliant. And blind.
          </.marketing_heading>
          <p class="mt-6 text-lg leading-relaxed text-zinc-400 text-pretty">
            Claude, Cursor, and ChatGPT reason about your stack all day — but they can't see it
            running. Emisar gives your agent eyes and secure hands on production.
          </p>
          <p class="mt-8 text-sm">
            <.cta_link navigate={~p"/packs"}>Find actions for your stack</.cta_link>
          </p>
        </div>

        <div class="space-y-3">
          <%= for {icon, title, desc} <- [
            {"action.search", "Starts from real state",
             "Give your agent live logs, metrics, and service state. It can follow the evidence without waiting for you to collect every result."},
            {"story.debug", "Debugs what it shipped",
             "Deployed something that misbehaves? Your agent can inspect the running result, find its mistake, and propose a fix. You don't have to gather the context for it."},
            {"story.alerting", "Works the incident",
             "When the page fires, your agent can investigate across the fleet, line up logs with metrics, and narrow down the cause. You get the evidence and a proposed fix."},
            {"product.run", "The change waits for you",
             "Let routine work run on its own. Put restarts, deployments, and other changes behind approval. Your agent does the legwork; you decide when the change runs."}
          ] do %>
            <div class="flex gap-4 rounded-2xl border border-zinc-900 bg-zinc-950/60 p-6">
              <div class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
                <.icon name={icon} class="h-5 w-5" />
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white">{title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{desc}</p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%!-- Three-pillar deep-dive — the mechanism: a catalog, a gate, and a ledger.
       Unshaded, so it alternates between the shaded capabilities above and the
       shaded demo below. --%>
  <section class="py-24 sm:py-32">
    <div data-reveal class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-base font-semibold text-brand-400">How access works</p>
        <.marketing_heading tag="h2" scale={:section} class="mt-2">
          Connect your infrastructure through one MCP server.
        </.marketing_heading>
        <p class="mt-6 text-lg text-zinc-400 leading-relaxed">
          Add capabilities through packs, without buying another access tool or setting up
          agent access in another system. Your agents get one organized catalog, governed
          by the same policies, through the MCP connection they already use.
        </p>
      </div>

      <div class="mx-auto mt-16 grid max-w-7xl grid-cols-1 gap-8 lg:grid-cols-3">
        <%!-- Pillar 1: Catalog --%>
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
            <.icon name="pack.reference" class="h-5 w-5" />
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Versioned action catalog</h3>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed">
            Start with published packs for the software you run. Each action defines its
            command, arguments, and limits. Add your own procedures as custom
            actions; an admin must trust a custom pack before it can run.
          </p>
          <div class="mt-6 overflow-hidden rounded-lg border border-zinc-900 bg-black/60">
            <div class="border-b border-zinc-900 px-3 py-2 font-mono text-[11px] text-zinc-400">
              linux-core/actions/systemctl_status.yaml
            </div>
            <pre class="overflow-x-auto p-3 font-mono text-[11px] leading-5 text-zinc-300"><span class="text-sky-300">schema_version</span>: <span class="text-amber-300">1</span>
<span class="text-sky-300">id</span>: linux.systemctl_status
<span class="text-sky-300">title</span>: <span class="text-brand-300">"Systemd unit status"</span>
<span class="text-sky-300">kind</span>: exec
<span class="text-sky-300">risk</span>: <span class="text-amber-300">medium</span>
<span class="text-sky-300">args</span>:
  - <span class="text-sky-300">name</span>: unit
    <span class="text-sky-300">type</span>: string
    <span class="text-sky-300">required</span>: <span class="text-amber-300">true</span>
    <span class="text-sky-300">validation</span>:
      <span class="text-sky-300">pattern</span>: <span class="text-brand-300">"^[a-zA-Z0-9@:_.][a-zA-Z0-9@:_.\-]&#123;0,127&#125;$"</span>
<span class="text-sky-300">execution</span>:
  <span class="text-sky-300">command</span>:
    <span class="text-sky-300">binary</span>: systemctl
    <span class="text-sky-300">argv</span>: [<span class="text-brand-300">"status"</span>, <span class="text-brand-300">"&#123;&#123; args.unit &#125;&#125;"</span>, <span class="text-brand-300">"--no-pager"</span>, <span class="text-brand-300">"--lines=10"</span>]</pre>
          </div>
        </div>

        <%!-- Pillar 2: Policy --%>
        <div class="rounded-2xl border border-brand-500/30 bg-zinc-950/60 p-8 ring-1 ring-brand-500/10">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
            <.icon name="trust.policy_enforced" class="h-5 w-5" />
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Policy &amp; approval</h3>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed">
            Choose which actions run automatically, need approval, or are denied. Set rules
            by risk, action, host, or group. Require one or several approvers. For repeated
            work, issue a standing grant. Limit its scope and revoke it at any time.
          </p>
          <div class="mt-6 overflow-hidden rounded-lg border border-zinc-900 bg-black/60">
            <div class="border-b border-zinc-900 px-3 py-2 font-mono text-[11px] text-zinc-400">
              Risk-tier defaults
            </div>
            <div class="divide-y divide-zinc-900 p-3 font-mono text-[11px] text-zinc-300">
              <div class="flex items-center justify-between py-2">
                <span>low</span><span class="text-brand-300">allow</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span>medium</span><span class="text-brand-300">allow</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span>high</span><span class="text-amber-300">require approval</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span>critical</span><span class="text-rose-300">deny</span>
              </div>
              <div class="flex items-center justify-between pt-3 text-[10px] uppercase tracking-wider text-zinc-400">
                <span>Overrides</span>
                <span class="normal-case tracking-normal">first match wins</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="truncate text-zinc-400">*.delete_*</span>
                <span class="ml-3 flex-none text-rose-300">deny</span>
              </div>
              <div class="flex items-center justify-between py-2">
                <span class="truncate text-zinc-400">nomad.job_*</span>
                <span class="ml-3 flex-none text-amber-300">require approval</span>
              </div>
              <div class="pt-3 text-[10px] leading-4 text-zinc-400">
                Or scope a stricter ruleset to a single runner or a group.
              </div>
            </div>
          </div>
        </div>

        <%!-- Pillar 3: Audit --%>
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
            <.icon name="evidence.verified_document" class="h-5 w-5" />
          </div>
          <h3 class="mt-6 text-xl font-semibold text-white">Audit + runner journal</h3>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed">
            Review the request, policy decision, and outcome in one place. Open the linked
            run for command details and redacted output. The runner keeps a separate
            hash-chained journal on the host. Team and Enterprise include audit-event
            export to your SIEM.
          </p>
          <div class="mt-6 overflow-hidden rounded-lg border border-zinc-900 bg-black/60">
            <div class="border-b border-zinc-900 px-3 py-2 font-mono text-[11px] text-zinc-400">
              emisar.dev / audit
            </div>
            <div class="divide-y divide-zinc-900 font-mono text-[11px] tabular-nums">
              <div
                :for={
                  {time, title, type, chip, title_class, actor_kind, actor_label} <- [
                    {"14:02", "Run succeeded", "action_run.success", "nomad.alloc_logs",
                     "text-brand-300", "api_key", "claude-prod"},
                    {"14:01", "Awaiting approval", "action_run.pending_approval",
                     "nomad.job_revert", "text-amber-300", "api_key", "claude-prod"},
                    {"13:58", "Approval granted", "approval.approved", "caddy.reload_config",
                     "text-brand-300", "user", "ops@acme.co"},
                    {"13:52", "Denied by policy", "action_run.denied", "linux.reboot_host",
                     "text-rose-300", "api_key", "claude-prod"}
                  ]
                }
                class="flex gap-3 px-3 py-2.5"
              >
                <span class="flex-none text-zinc-400">{time}</span>
                <div class="min-w-0 flex-1">
                  <div class={[title_class, "font-medium"]}>{title}</div>
                  <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] text-zinc-400">
                    <span>{type}</span>
                    <span class="rounded-sm bg-zinc-800/60 px-1.5 py-0.5 text-zinc-400">{chip}</span>
                  </div>
                  <%!-- Actor on its own line, consistent across rows. System
                       (engine) actor is highlighted like the api_key actors. --%>
                  <div class="mt-1 text-[10px] text-zinc-400">
                    <span :if={actor_label}>
                      {actor_kind}: <span class="text-brand-300">{actor_label}</span>
                    </span>
                    <span :if={!actor_label} class="text-zinc-300">{actor_kind}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="mt-12 text-center text-sm">
        <.cta_link navigate={~p"/packs"}>Browse all {@action_count} actions across {@pack_count} packs — Postgres, Docker, Nomad, Kubernetes, the AWS suite, and more</.cta_link>
      </p>
    </div>
  </section>

  <%!-- Watch it work — the live demo, right after the mechanism above: the
       reader has seen the catalog, the gate, and the ledger; now all three run
       a real incident end to end. --%>
  <section class="border-y border-zinc-900 bg-zinc-950/40 py-24 sm:py-32">
    <div data-reveal class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-base font-semibold text-brand-400">Watch it work</p>
        <.marketing_heading tag="h2" scale={:section} class="mt-2">
          A real incident, start to finish.
        </.marketing_heading>
        <p class="mt-6 text-lg leading-relaxed text-zinc-400 text-pretty">
          A CSI driver erased 33 hours of metrics by reformatting a live storage volume.
          Follow the agent's investigation, the approved action that stopped further writes,
          and the Terraform fix it prepared for review.
        </p>
      </div>

      <.emisar_demo />
    </div>
  </section>

  <%!-- Comparison table --%>
  <section class="py-24 sm:py-32">
    <div data-reveal class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-base font-semibold text-brand-400">Why not just&hellip;</p>
        <.marketing_heading tag="h2" scale={:section} class="mt-2">
          Production access. Without the blank check.
        </.marketing_heading>
        <p class="mt-6 text-lg text-zinc-400 leading-relaxed">
          An agent with unrestricted host access and your SSH keys can investigate, deploy,
          or delete. emisar gives your agent production tools with rules enforced before
          each action. A custom MCP server puts those controls on your own build list.
        </p>
      </div>

      <% comparison_rows = [
        {"Read logs and query metrics", true},
        {"Deploy and restart services", true},
        {"Run your own procedures", true},
        {"Limit actions by policy", false},
        {"Validate action arguments", false},
        {"Require approval for changes", false},
        {"Issue and revoke standing grants", false},
        {"Record actions and policy decisions", false}
      ] %>

      <div class="mx-auto mt-16 hidden overflow-hidden rounded-2xl border border-zinc-900 bg-zinc-950/60 md:block">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <caption class="sr-only">
              emisar compared with unrestricted agent access through SSH and a custom MCP server
            </caption>
            <thead>
              <tr class="border-b border-zinc-900 text-xs uppercase tracking-wider text-zinc-400">
                <th scope="col" class="px-6 py-4 font-medium">Capability</th>
                <th scope="col" class="px-6 py-4 font-semibold text-brand-300">emisar</th>
                <th scope="col" class="px-6 py-4 font-medium">Unrestricted SSH access</th>
                <th scope="col" class="px-6 py-4 font-medium">Custom MCP server</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-900 text-zinc-300">
              <%= for {row, ssh} <- comparison_rows do %>
                <tr class="hover:bg-zinc-900/30">
                  <th scope="row" class="px-6 py-4 font-medium text-zinc-100">{row}</th>
                  <td class="px-6 py-4">
                    <.state_chip state={:pass} label="Yes" />
                  </td>
                  <td class="px-6 py-4">
                    <%= if ssh do %>
                      <.state_chip state={:pass} label="Yes" />
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 text-zinc-400">
                        <.icon name="state.not_included" class="h-4 w-4" />No
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-zinc-400">Build it</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-10 divide-y divide-zinc-800 border-y border-zinc-800 md:hidden">
        <div :for={{row, ssh} <- comparison_rows} class="py-5">
          <h3 class="text-sm font-semibold text-zinc-100">{row}</h3>
          <dl class="mt-3 grid grid-cols-3 gap-3 text-sm">
            <div>
              <dt class="mb-2 text-xs font-medium text-brand-400">emisar</dt>
              <dd><.state_chip state={:pass} label="Yes" /></dd>
            </div>
            <div>
              <dt class="mb-2 text-xs text-zinc-400">Unrestricted SSH</dt>
              <dd>
                <%= if ssh do %>
                  <.state_chip state={:pass} label="Yes" />
                <% else %>
                  <span class="inline-flex items-center gap-1.5 text-zinc-400">
                    <.icon name="state.not_included" class="h-4 w-4" />No
                  </span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="mb-2 text-xs text-zinc-400">Custom MCP</dt>
              <dd class="text-zinc-400">Build it</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-center text-sm">
        <.cta_link navigate={~p"/compare/raw-ssh-for-ai"}>Read the full SSH-for-AI comparison</.cta_link>
        <.cta_link navigate={~p"/compare/custom-mcp-server"}>Compare with a custom MCP server</.cta_link>
        <.cta_link navigate={~p"/compare/copy-paste-ai-ops"}>Compare with the copy-paste workflow</.cta_link>
      </div>
    </div>
  </section>

  <%!-- Case studies — proof the demo wasn't cherry-picked: the storage wipe from
       the demo written up in full, plus a completely different failure on the
       network. These are the two REAL incidents; the weaker "real-shape" datastore
       walkthroughs (Postgres/Cassandra) were cut from the showcase — they live on
       as pack-supporting pages, reachable from their packs and docs. Each card
       links to its post-mortem; the hub link below carries the everyday wins too. --%>
  <section class="border-y border-zinc-900 bg-zinc-950/40 py-24 sm:py-32">
    <div data-reveal class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-base font-semibold text-brand-400">Case studies</p>
        <.marketing_heading tag="h2" scale={:section} class="mt-2">
          Two incidents, in full.
        </.marketing_heading>
        <p class="mt-6 text-lg leading-relaxed text-zinc-400 text-pretty">
          The storage wipe from the demo, written up end to end — and a completely different
          failure on the network. Both real, both logged with the command output to prove it.
        </p>
      </div>

      <div class="mx-auto mt-16 grid max-w-3xl grid-cols-1 gap-6 sm:grid-cols-2">
        <%= for {tag, title, scenario, icon, href} <- [
          {"storage", "A CSI driver wiped 33 hours of metrics",
           "The incident from the demo, in full — including the twist. The obvious one-line fix was a no-op, so the durable fix the agent shipped is a guard that refuses to trust the driver.",
           "infrastructure.database", ~p"/use-cases/csi-data-loss"},
          {"ingress", "A fleet-wide 502 no backend was causing",
           "Every app behind one edge threw intermittent 502s — yet every backend was green. The agent traced it across five layers to an OOM loop and a stuck node still advertising a dead ingress, then stopped the bleed behind gated approvals.",
           "infrastructure.network", ~p"/use-cases/ingress-502"}
        ] do %>
          <div class="group flex flex-col rounded-2xl border border-zinc-900 bg-zinc-950/60 p-8 transition hover:-translate-y-0.5 hover:border-brand-500/40">
            <div class="flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400">
                <.icon name={icon} class="h-5 w-5" />
              </div>
              <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-400">
                {tag}
              </span>
            </div>
            <h3 class="mt-6 text-lg font-semibold text-white">{title}</h3>
            <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{scenario}</p>
            <.cta_link navigate={href} class="mt-4 inline-block text-sm">Read the post-mortem</.cta_link>
          </div>
        <% end %>
      </div>

      <p class="mt-12 text-center text-sm">
        <.cta_link navigate={~p"/use-cases"}>See every use case — the daily wins and the war stories</.cta_link>
      </p>
    </div>
  </section>

  <%!-- Zero Trust validation — the third-party-framework authority capstone,
       last of the proof run (comparison → use cases → here) before pricing.
       Unshaded, alternating between the shaded use cases above and shaded
       pricing below. --%>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-base font-semibold text-brand-400">Zero Trust for AI Agents</p>
        <.marketing_heading tag="h2" scale={:section} class="mt-2">
          The framework a frontier lab published — enforced by emisar.
        </.marketing_heading>
        <p class="mt-6 text-lg leading-8 text-zinc-400 text-pretty">
          Anthropic's
          <a
            href="https://cdn.prod.website-files.com/6889473510b50328dbb70ae6/6a1611a04085d7cd3dadc924_Claude-eBook-Zero-Trust-for-AI-Agents-05182026.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-300 underline decoration-zinc-700 underline-offset-4 hover:text-brand-200"
          >
            Zero Trust for AI Agents
          </a>
          guide says an agent with access to real systems needs four things: least agency,
          deny-by-default tools, human approval for high-risk actions, and durable audit evidence.
          Emisar applies these controls to each action and records the work in the cloud audit
          and a separate journal on the host.
          We ship core action controls on the Free plan.
        </p>
      </div>

      <div class="mt-10 text-center text-sm">
        <.cta_link navigate={~p"/zero-trust"}>See emisar mapped to the framework, control by control</.cta_link>
        <p class="mx-auto mt-4 max-w-xl text-xs leading-relaxed text-zinc-400">
          Not affiliated with or endorsed by Anthropic. We cite the framework because emisar is
          built to the control set it describes.
        </p>
      </div>
    </div>
  </section>

  <section id="get-started" class="border-t border-zinc-900 py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8">
      <div>
        <.marketing_heading tag="h2" scale={:section}>
          Deploy in about five minutes.
        </.marketing_heading>
        <p class="mt-6 text-lg leading-8 text-zinc-400">
          Keep your existing infrastructure and AI client. The runner connects out,
          so there's no inbound port to open or SSH key to hand over.
        </p>
        <.cta_link navigate={~p"/docs/quickstart"} class="mt-6 inline-block text-sm">Follow the quickstart</.cta_link>
      </div>
      <ol class="divide-y divide-zinc-800 border-y border-zinc-800">
        <%= for {number, title, detail} <- [
          {"01", "Install the runner", "Create a free account and copy the install command to your Linux host. The runner connects to emisar automatically."},
          {"02", "Choose your packs", "Use the packs suggested for your host. Set which actions run on their own and which need approval."},
          {"03", "Connect your agent", "Add emisar to your MCP client. Ask your agent to investigate a service, check a deployment, or handle a routine task."}
        ] do %>
          <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-4 py-6">
            <span class="pt-0.5 font-mono text-sm text-brand-400">{number}</span>
            <div>
              <h3 class="text-lg font-semibold text-zinc-100">{title}</h3>
              <p class="mt-2 text-base leading-7 text-zinc-400">{detail}</p>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <%!-- Pricing teaser --%>
  <section class="border-y border-zinc-900 bg-zinc-950/40 py-24 sm:py-32">
    <div data-reveal class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-base font-semibold text-brand-400">Pricing</p>
        <.marketing_heading tag="h2" scale={:section} class="mt-2">
          Pay per runner. Not per seat.
        </.marketing_heading>
        <p class="mt-6 text-lg text-zinc-400 leading-relaxed">
          Free for 3 runners and 1 user. Team is $20/runner/month with unlimited users.
        </p>
      </div>

      <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-8">
          <h3 class="text-lg font-semibold text-white">Free</h3>
          <p class="mt-2 text-sm text-zinc-400">For a first host or a small setup.</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl font-bold text-white text-balance">$0</span>
            <span class="text-sm text-zinc-400">/ forever</span>
          </div>
          <.marketing_button variant={:secondary} href={~p"/sign_up"} block class="mt-8">
            Start free
          </.marketing_button>
          <ul class="mt-8 space-y-2 text-sm text-zinc-300">
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" /> 3 runners
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" /> 1 user
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              7-day audit retention
            </li>
          </ul>
        </div>
        <div class="relative rounded-2xl border-2 border-brand-500/60 bg-zinc-950/80 p-8 shadow-2xl shadow-brand-950/40">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-500 px-3 py-0.5 text-[10px] font-semibold uppercase tracking-widest text-zinc-950">
            For teams
          </span>
          <h3 class="text-lg font-semibold text-white">Team</h3>
          <p class="mt-2 text-sm text-zinc-400">For teams operating production.</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl font-bold text-white text-balance">$20</span>
            <span class="text-sm text-zinc-400">/ runner / month</span>
          </div>
          <.marketing_button href={~p"/sign_up"} block class="mt-8">
            Start free
          </.marketing_button>
          <ul class="mt-8 space-y-2 text-sm text-zinc-300">
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              Up to 100 runners
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              Unlimited users
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              90-day audit retention
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              Automated invoices, email support
            </li>
          </ul>
        </div>
        <div class="rounded-2xl border border-zinc-900 bg-zinc-950/60 p-8">
          <h3 class="text-lg font-semibold text-white">Enterprise</h3>
          <p class="mt-2 text-sm text-zinc-400">
            For larger fleets and procurement requirements.
          </p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl font-bold text-white text-balance">Custom</span>
          </div>
          <.marketing_button
            variant={:secondary}
            href={EmisarWeb.MailTo.sales()}
            block
            class="mt-8"
          >
            Talk to sales
          </.marketing_button>
          <ul class="mt-8 space-y-2 text-sm text-zinc-300">
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              Unlimited runners &amp; users
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              365-day audit retention
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              Security and procurement review
            </li>
            <li class="flex gap-2">
              <.icon name="state.included" class="h-4 w-4 flex-none text-brand-400" />
              Design-partner deployment planning
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <%!-- FAQ --%>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <div class="text-center">
        <p class="text-base font-semibold text-brand-400">FAQ</p>
        <.marketing_heading tag="h2" scale={:section} class="mt-2">
          Before you get started.
        </.marketing_heading>
      </div>

      <div class="mt-16 divide-y divide-zinc-900 overflow-hidden rounded-2xl border border-zinc-900 bg-zinc-950/60">
        <%= for {q, a} <- @faqs do %>
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between transition-colors hover:bg-zinc-900/30 px-8 py-6 text-base font-semibold text-zinc-50">
              {q}
              <.icon
                name="action.disclose"
                class="h-5 w-5 shrink-0 text-zinc-500 transition duration-200 group-hover:text-zinc-300 group-open:rotate-180 group-open:text-brand-400"
              />
            </summary>
            <p class="px-8 pb-6 text-sm text-zinc-400 leading-relaxed">{a}</p>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <%!-- Final CTA --%>
  <section class="pb-24 sm:pb-32">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-lg border border-brand-500/30 bg-zinc-950 p-12 sm:p-16">
        <div class="glow-emerald pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <div class="grain pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <div class="relative text-center">
          <.marketing_heading tag="h2" scale={:section}>
            Give your AI production access. Without losing sleep.
          </.marketing_heading>
          <p class="mx-auto mt-6 max-w-xl text-lg text-zinc-400 leading-relaxed">
            Let your agents investigate, deploy, and keep production running.
            You set the rules. emisar enforces them on every action.
          </p>
          <form
            action={~p"/sign_up"}
            method="get"
            class="mx-auto mt-10 flex max-w-md flex-col items-center gap-3 sm:flex-row"
          >
            <label for="cta-email" class="sr-only">Work email</label>
            <input
              type="email"
              name="email"
              id="cta-email"
              autocomplete="email"
              placeholder="you@company.com"
              class="w-full rounded-lg border-0 bg-zinc-900/80 px-4 py-2.5 text-sm text-white ring-1 ring-zinc-800 placeholder:text-zinc-500 focus:ring-2 focus:ring-brand-500"
            />
            <.marketing_button type="submit" icon="action.next" class="w-full sm:w-auto">
              Start free
            </.marketing_button>
          </form>
          <p class="mt-5 text-sm text-zinc-400">
            Prefer a walkthrough first? <a
              href="https://cal.com/andrew-dryga/emisar"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-brand-400 hover:text-brand-300"
            >Book a 30-minute demo</a>.
          </p>
          <p class="mt-4 text-xs text-zinc-400">
            Free for 3 runners. No credit card required.
          </p>
        </div>
      </div>
    </div>
  </section>

  <.marketing_footer />
</div>
