#!/usr/bin/env bash
set -euo pipefail

root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
goos=$(GOTOOLCHAIN=local go env GOOS)
goarch=$(GOTOOLCHAIN=local go env GOARCH)
cache=${XDG_CACHE_HOME:-${HOME:?}/.cache}/emisar
workspace=$(printf '%s' "$root" | cksum | awk '{print $1}')
binary="$cache/devtool-${goos}-${goarch}-${workspace}"
temporary="$binary.tmp.$$"

mkdir -p "$cache"
chmod 700 "$cache"
trap 'rm -f "$temporary"' EXIT

rebuild=false
if [[ ! -x "$binary" ]]; then
  rebuild=true
elif [[ "$root/.tool-versions" -nt "$binary" || "$root/tools/go.mod" -nt "$binary" || "$root/tools/go.sum" -nt "$binary" ]]; then
  rebuild=true
elif find "$root/tools" -type f -name '*.go' -newer "$binary" -print -quit | grep -q .; then
  rebuild=true
fi

if [[ "$rebuild" == true ]]; then
  (cd "$root/tools" && GOTOOLCHAIN=local go build -trimpath -o "$temporary" ./cmd/devtool)
  chmod 700 "$temporary"
  mv -f "$temporary" "$binary"
fi

trap - EXIT
exec "$binary" "$@"
