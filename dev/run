#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
PORTAL="$ROOT/portal"
BROWSER_TOOLS="$ROOT/tools/browser"
CERTS="$ROOT/dev/keycloak/certs/generated"
OIDC_SECRET="emisar-oidc-dev-secret-DO-NOT-USE-IN-PROD"
SCIM_TOKEN="dev-scim-token"
CERTS_CHANGED=0

die() { echo "dev/run: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing $1"; }
in_box() { [[ -f /.dockerenv && -n "${COOP_SERVE_URL_4000:-}" ]]; }

usage() {
  cat <<'EOF'
usage: dev/run <command> [args]

  setup                    build the box, start dependencies, install deps, migrate
  up | down                start/stop this workspace's shared dependencies
  serve                    run Phoenix directly in the host or active Coop box
  seed                     explicitly apply the idempotent demo seed
  reset [--seed] [--yes]   destroy and recreate the dev database
  urls                     print this workspace's Portal, Postgres, and Keycloak URLs
  doctor                   verify tools, TLS, dependencies, and the OIDC issuer
  certs [--rotate|trust|untrust|status]
                           manage ignored Keycloak certificates and host trust
  browser <start|stop|status|install>
  shot <path> ...          capture through the persistent browser (shot.mjs args)
  capture <docs|console>   run a full screenshot workflow against this workspace
  e2e <sso|signing|billing>
                           run a cross-component development scenario
  check changed            compile, then check only changed Portal source files
  check portal             compile, format-check, and run Credo for all Portal files
  check agent-setup        validate shared agent manuals, skills, tasks, and hooks
  check tooling            lint and test the shared development tooling
  test portal <args...>    run focused, --stale, --failed, or listening Portal tests
  gate portal              run the canonical Portal gate
  pack check <name>        validate one pack without changing artifacts
  pack sync <name> --fix   rebuild the authoritative catalog and focused tests
  smoke                    build and start the packaged root Compose topology
EOF
}

workspace_json() {
  need coop
  need jq
  local json row
  json=$(coop fork ls --json)
  row=$(jq -cer --arg path "$ROOT" '.workspaces[] | select(.path == $path)' <<<"$json" 2>/dev/null) ||
    die "coop did not report URLs for workspace $ROOT"
  printf '%s\n' "$row"
}

load_urls() {
  if in_box; then
    PORTAL_URL=${COOP_SERVE_URL_4000:?missing COOP_SERVE_URL_4000}
    METRICS_URL=${COOP_SERVE_URL_9091:?missing COOP_SERVE_URL_9091}
    DB_SERVICE_URL=${COOP_SERVICE_DB_URL:?missing COOP_SERVICE_DB_URL}
    KEYCLOAK_URL=${COOP_SERVICE_KEYCLOAK_URL:?missing COOP_SERVICE_KEYCLOAK_URL}
  else
    local row
    row=$(workspace_json)
    PORTAL_URL=$(jq -er '.serve["4000"]' <<<"$row")
    METRICS_URL=$(jq -er '.serve["9091"]' <<<"$row")
    DB_SERVICE_URL=$(jq -er '.services["db:5432"]' <<<"$row")
    KEYCLOAK_URL=$(jq -er '.services["keycloak:8443"]' <<<"$row")
  fi

  DB_PORT=${DB_SERVICE_URL##*:}
  printf -v DATABASE_URL 'ecto://%s:%s@localhost:%s/emisar_dev' postgres postgres "$DB_PORT"
  EMISAR_DEV_URL=$PORTAL_URL
  EMISAR_DEV_KEYCLOAK_ISSUER="${KEYCLOAK_URL}/realms/emisar"
  EMISAR_DEV_CA_BUNDLE="$CERTS/ca-bundle.crt"
  PGHOST=localhost
  PGPORT=$DB_PORT
  export DATABASE_URL EMISAR_DEV_URL EMISAR_DEV_KEYCLOAK_ISSUER EMISAR_DEV_CA_BUNDLE PGHOST PGPORT
}

make_ca_bundle() {
  [[ -s "$CERTS/ca.crt" ]] || die "Keycloak CA is missing; run dev/run certs"
  local tmp="$CERTS/.ca-bundle.$$"
  if [[ "$(uname -s)" == Darwin ]]; then
    need security
    security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain >"$tmp"
  elif [[ -s /etc/ssl/certs/ca-certificates.crt ]]; then
    cp /etc/ssl/certs/ca-certificates.crt "$tmp"
  else
    die "cannot locate the system CA bundle"
  fi
  printf '\n' >>"$tmp"
  cat "$CERTS/ca.crt" >>"$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$EMISAR_DEV_CA_BUNDLE"
}

certs_generate() {
  in_box && die "generate or rotate development certificates on the host"
  local before="" after
  if [[ -s "$CERTS/tls.crt" ]]; then
    before=$(openssl x509 -in "$CERTS/tls.crt" -noout -fingerprint -sha256 2>/dev/null || true)
  fi
  "$ROOT/dev/keycloak/certs/gen.sh" "$@"
  after=$(openssl x509 -in "$CERTS/tls.crt" -noout -fingerprint -sha256)
  [[ -n "$before" && "$before" == "$after" ]] && CERTS_CHANGED=0 || CERTS_CHANGED=1
}

refresh_coop_services_for_certificate() {
  [[ $CERTS_CHANGED -eq 1 ]] || return 0
  need coop
  echo "recreating dependency services after Keycloak certificate change"
  (cd "$ROOT" && coop down && coop up)
}

cert_fingerprint() {
  [[ -s "$CERTS/ca.crt" ]] || die "Keycloak CA is missing; run dev/run certs"
  need openssl
  openssl x509 -in "$CERTS/ca.crt" -noout -fingerprint -sha256 |
    sed 's/^.*=//; s/://g' |
    tr '[:lower:]' '[:upper:]'
}

login_keychain() {
  need security
  security default-keychain -d user | sed 's/^[[:space:]]*"//; s/"[[:space:]]*$//'
}

require_macos_host() {
  in_box && die "manage host browser trust from the host"
  [[ "$(uname -s)" == Darwin ]] || die "host browser trust is currently supported on macOS only"
}

cert_installed() {
  local fingerprint keychain
  fingerprint=$(cert_fingerprint)
  keychain=$(login_keychain)
  security find-certificate -a -Z -c "emisar dev CA" "$keychain" 2>/dev/null |
    grep -Fq "SHA-256 hash: $fingerprint"
}

cert_trusted() {
  cert_installed &&
    security verify-cert -q -c "$CERTS/tls.crt" -p ssl -s localhost -L >/dev/null 2>&1
}

cert_trust() {
  require_macos_host
  certs_generate
  refresh_coop_services_for_certificate
  if cert_trusted; then
    echo "✓ Keycloak dev CA already trusted for https://localhost"
    return
  fi

  local keychain
  keychain=$(login_keychain)
  security add-trusted-cert -r trustRoot -p ssl -s localhost -k "$keychain" "$CERTS/ca.crt"
  cert_trusted || die "macOS did not trust the Keycloak dev CA"
  echo "✓ trusted Keycloak dev CA for https://localhost in $keychain"
}

cert_untrust() {
  require_macos_host
  [[ -s "$CERTS/ca.crt" ]] || { echo "Keycloak dev CA is not generated"; return; }
  if ! cert_installed; then
    echo "Keycloak dev CA is not installed in the user keychain"
    return
  fi

  local fingerprint keychain
  fingerprint=$(cert_fingerprint)
  keychain=$(login_keychain)
  security delete-certificate -t -Z "$fingerprint" "$keychain" >/dev/null
  if cert_installed; then
    die "could not remove Keycloak dev CA $fingerprint from $keychain"
  fi
  echo "✓ removed Keycloak dev CA $fingerprint from $keychain"
}

cert_trust_status() {
  require_macos_host
  if cert_trusted; then
    echo "trusted for https://localhost ($(cert_fingerprint))"
    return
  fi
  echo "not trusted; run: dev/run certs trust"
  return 1
}

certs_rotate() {
  in_box && die "generate or rotate development certificates on the host"
  local restore_trust=0
  if [[ "$(uname -s)" == Darwin && -s "$CERTS/ca.crt" ]] && cert_installed; then
    restore_trust=1
    cert_untrust
  fi
  certs_generate --rotate
  refresh_coop_services_for_certificate
  [[ $restore_trust -eq 0 ]] || cert_trust
}

certs_command() {
  case "${1:-}" in
    "") certs_generate; refresh_coop_services_for_certificate ;;
    --rotate) [[ $# -eq 1 ]] || die "usage: dev/run certs [--rotate|trust|untrust|status]"; certs_rotate ;;
    trust) [[ $# -eq 1 ]] || die "usage: dev/run certs trust"; cert_trust ;;
    untrust) [[ $# -eq 1 ]] || die "usage: dev/run certs untrust"; cert_untrust ;;
    status) [[ $# -eq 1 ]] || die "usage: dev/run certs status"; cert_trust_status ;;
    *) die "usage: dev/run certs [--rotate|trust|untrust|status]" ;;
  esac
}

up() {
  if in_box; then
    load_urls
  else
    certs_generate
    need coop
    if [[ $CERTS_CHANGED -eq 1 ]]; then
      (cd "$ROOT" && coop down)
    fi
    (cd "$ROOT" && coop up)
    load_urls
  fi
  make_ca_bundle
}

wait_for_dependencies() {
  need curl
  need pg_isready
  local _
  for _ in {1..60}; do
    if pg_isready -h localhost -p "$DB_PORT" -U postgres -d emisar_dev >/dev/null 2>&1; then break; fi
    sleep 1
  done
  pg_isready -h localhost -p "$DB_PORT" -U postgres -d emisar_dev >/dev/null 2>&1 ||
    die "Postgres did not become ready at $DB_SERVICE_URL"

  for _ in {1..90}; do
    if curl -fsS --cacert "$CERTS/ca.crt" \
      "$KEYCLOAK_URL/realms/master/.well-known/openid-configuration" >/dev/null 2>&1; then break; fi
    sleep 1
  done
  curl -fsS --cacert "$CERTS/ca.crt" \
    "$KEYCLOAK_URL/realms/master/.well-known/openid-configuration" >/dev/null ||
    die "Keycloak did not become ready at $KEYCLOAK_URL"
}

configure_keycloak() {
  need jq
  wait_for_dependencies
  local token client callback payload _
  callback="${PORTAL_URL}/sign_in/sso/callback"

  for _ in {1..30}; do
    token=$(curl -fsS --cacert "$CERTS/ca.crt" \
      -d client_id=admin-cli -d username=admin -d password=admin \
      -d grant_type=password \
      "$KEYCLOAK_URL/realms/master/protocol/openid-connect/token" |
      jq -er '.access_token' 2>/dev/null) && break
    sleep 1
  done
  [[ -n "${token:-}" ]] || die "could not obtain the Keycloak dev admin token"

  client=$(curl -fsS --cacert "$CERTS/ca.crt" -H "Authorization: Bearer $token" \
    "$KEYCLOAK_URL/admin/realms/emisar/clients?clientId=emisar-portal" |
    jq -cer 'if length == 1 then .[0] else error("emisar-portal client missing or duplicated") end')
  payload=$(jq -c --arg callback "$callback" --arg origin "$PORTAL_URL" '
    .redirectUris = [$callback]
    | .webOrigins = [$origin]
    | .attributes = (.attributes // {})
    | .attributes["post.logout.redirect.uris"] = ($origin + "/*")
  ' <<<"$client")
  curl -fsS --cacert "$CERTS/ca.crt" -X PUT \
    -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    --data "$payload" "$KEYCLOAK_URL/admin/realms/emisar/clients/$(jq -r '.id' <<<"$client")"
}

prepare_database() {
  (cd "$PORTAL" && mix ecto.create && mix ecto.migrate)
}

install_browser() {
  (cd "$BROWSER_TOOLS" && npm ci --ignore-scripts && npm run browser:install)
}

setup() {
  need mix
  need npm
  if ! in_box; then
    need coop
    (cd "$ROOT" && coop build)
  fi
  up
  wait_for_dependencies
  (cd "$PORTAL" && mix deps.get)
  prepare_database
  install_browser
  configure_keycloak
  echo "✓ development setup ready; run 'dev/run seed' once when demo data is needed"
  urls
}

seed() {
  up
  configure_keycloak
  prepare_database
  (
    export EMISAR_DEV_FIXED_OIDC_CLIENT_SECRET="$OIDC_SECRET"
    export EMISAR_DEV_KEYCLOAK_PROVIDER_ID="11111111-1111-7111-8111-111111111111"
    export EMISAR_DEV_FIXED_SCIM_TOKEN="$SCIM_TOKEN"
    cd "$PORTAL"
    mix run --no-start -e \
      'Logger.configure(level: :info); {:ok, _} = Application.ensure_all_started(:emisar); Code.eval_file("apps/emisar/priv/repo/seeds.exs")'
  )
}

reset_database() {
  local seed_after=0 yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      --seed) seed_after=1 ;;
      --yes) yes=1 ;;
      *) die "usage: dev/run reset [--seed] [--yes]" ;;
    esac
  done
  if [[ $yes -ne 1 ]]; then
    read -r -p "Drop this workspace's emisar_dev database? [y/N] " answer
    [[ "$answer" == y || "$answer" == Y ]] || exit 1
  fi
  up
  (cd "$PORTAL" && mix ecto.drop && mix ecto.create && mix ecto.migrate)
  configure_keycloak
  [[ $seed_after -eq 0 ]] || seed
}

serve() {
  up
  wait_for_dependencies
  configure_keycloak
  prepare_database

  local listen_port listen_ip metrics_port portal_proxy_pid="" metrics_proxy_pid=""
  if in_box; then
    need socat
    listen_port=4000
    metrics_port=9091
    listen_ip=0.0.0.0
    local portal_public_port=${PORTAL_URL##*:} metrics_public_port=${METRICS_URL##*:}
    socat "TCP-LISTEN:${portal_public_port},bind=127.0.0.1,fork,reuseaddr" \
      "TCP:127.0.0.1:${listen_port}" >/dev/null 2>&1 &
    portal_proxy_pid=$!
    socat "TCP-LISTEN:${metrics_public_port},bind=127.0.0.1,fork,reuseaddr" \
      "TCP:127.0.0.1:${metrics_port}" >/dev/null 2>&1 &
    metrics_proxy_pid=$!
  else
    listen_port=${PORTAL_URL##*:}
    metrics_port=${METRICS_URL##*:}
    listen_ip=127.0.0.1
  fi

  cleanup_serve() {
    [[ -z "${portal_proxy_pid:-}" ]] || kill "$portal_proxy_pid" >/dev/null 2>&1 || true
    [[ -z "${metrics_proxy_pid:-}" ]] || kill "$metrics_proxy_pid" >/dev/null 2>&1 || true
  }
  trap cleanup_serve EXIT
  echo "✓ serving Phoenix at $PORTAL_URL"
  local status=0
  (cd "$PORTAL" && METRICS_PORT="$metrics_port" EMISAR_LISTEN_PORT="$listen_port" EMISAR_LISTEN_IP="$listen_ip" mix phx.server) || status=$?
  cleanup_serve
  trap - EXIT
  return "$status"
}

urls() {
  load_urls
  printf 'Portal:   %s\nMetrics:  %s\nPostgres: %s\nKeycloak: %s\n' \
    "$PORTAL_URL" "$METRICS_URL" "$DB_SERVICE_URL" "$KEYCLOAK_URL"
}

doctor() {
  local tool
  for tool in jq curl openssl mix npm pg_isready; do need "$tool"; done
  if ! in_box; then
    need coop
    need docker
  fi
  up
  wait_for_dependencies
  configure_keycloak
  openssl verify -CAfile "$CERTS/ca.crt" "$CERTS/tls.crt"
  curl -fsS --cacert "$CERTS/ca.crt" \
    "$EMISAR_DEV_KEYCLOAK_ISSUER/.well-known/openid-configuration" |
    jq -e --arg issuer "$EMISAR_DEV_KEYCLOAK_ISSUER" '.issuer == $issuer' >/dev/null
  git -C "$ROOT" check-ignore -q dev/keycloak/certs/generated/tls.key ||
    die "generated Keycloak private keys are not ignored"
  if ! in_box && [[ "$(uname -s)" == Darwin ]]; then
    cert_trust_status || die "Keycloak TLS is valid, but the host browser does not trust its CA"
  fi
  echo "✓ tools, services, TLS, exact OIDC issuer, and key isolation are healthy"
  urls
}

browser_paths() {
  load_urls
  local key=${PORTAL_URL##*:}
  [[ -s "$CERTS/tls.crt" ]] || die "Keycloak certificate is missing; run dev/run certs on the host"
  need openssl
  BROWSER_STATE="${XDG_CACHE_HOME:-$HOME/.cache}/emisar/browser-${key}.json"
  BROWSER_PROFILE="${XDG_CACHE_HOME:-$HOME/.cache}/emisar/browser-${key}-profile"
  BROWSER_TLS_MARKER="$BROWSER_PROFILE/.emisar-tls-spki"
  EMISAR_DEV_TLS_SPKI=$(
    openssl x509 -in "$CERTS/tls.crt" -pubkey -noout |
      openssl pkey -pubin -outform DER 2>/dev/null |
      openssl dgst -sha256 -binary |
      openssl base64 -A
  )
  [[ "$EMISAR_DEV_TLS_SPKI" =~ ^[A-Za-z0-9+/]{43}=$ ]] || die "could not derive Keycloak certificate SPKI"
  export BASE_URL="$PORTAL_URL" BROWSER_STATE BROWSER_PROFILE PROFILE_DIR="$BROWSER_PROFILE"
  export BROWSER_TLS_MARKER EMISAR_DEV_TLS_SPKI
  mkdir -p "$(dirname "$BROWSER_STATE")" "$BROWSER_PROFILE"
}

recover_browser() {
  local active="$BROWSER_PROFILE/DevToolsActivePort" lock="$BROWSER_PROFILE/SingletonLock"
  [[ -s "$active" ]] || return 1
  [[ -s "$BROWSER_TLS_MARKER" ]] || return 1
  [[ "$(cat "$BROWSER_TLS_MARKER")" == "$EMISAR_DEV_TLS_SPKI" ]] || return 1
  local port endpoint lock_target browser_pid tmp
  port=$(sed -n '1p' "$active")
  endpoint=$(curl -fsS "http://127.0.0.1:${port}/json/version" | jq -er '.webSocketDebuggerUrl') || return 1
  lock_target=$(readlink "$lock" 2>/dev/null || true)
  browser_pid=${lock_target##*-}
  [[ "$browser_pid" =~ ^[0-9]+$ ]] && kill -0 "$browser_pid" 2>/dev/null || return 1
  tmp="${BROWSER_STATE}.$$"
  jq -n --argjson pid "$browser_pid" --arg endpoint "$endpoint" --arg tls_spki "$EMISAR_DEV_TLS_SPKI" \
    '{pid: $pid, browserPid: $pid, wsEndpoint: $endpoint, tlsSpki: $tls_spki}' >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$BROWSER_STATE"
  return 0
}

browser_start() {
  browser_paths
  [[ -d "$BROWSER_TOOLS/node_modules" ]] || install_browser
  if [[ -s "$BROWSER_STATE" ]]; then
    local pid state_spki
    pid=$(jq -r '.pid // empty' "$BROWSER_STATE" 2>/dev/null || true)
    state_spki=$(jq -r '.tlsSpki // empty' "$BROWSER_STATE" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      if [[ "$state_spki" == "$EMISAR_DEV_TLS_SPKI" ]]; then
        echo "✓ browser already running (pid $pid)"
        return
      fi
      echo "restarting browser after Keycloak certificate rotation"
      browser_stop
    else
      rm -f "$BROWSER_STATE"
    fi
  fi
  if recover_browser; then
    echo "✓ recovered workspace browser (pid $(jq -r .pid "$BROWSER_STATE"))"
    return
  fi
  nohup node "$BROWSER_TOOLS/browser-server.mjs" \
    >"${BROWSER_STATE%.json}.log" 2>&1 &
  local _
  for _ in {1..100}; do [[ -s "$BROWSER_STATE" ]] && break; sleep 0.1; done
  [[ -s "$BROWSER_STATE" ]] || die "browser did not start; see ${BROWSER_STATE%.json}.log"
  echo "✓ browser ready (pid $(jq -r .pid "$BROWSER_STATE"))"
}

browser_stop() {
  browser_paths
  [[ -s "$BROWSER_STATE" ]] || { echo "browser is not running"; return; }
  local pid browser_pid
  pid=$(jq -r '.pid' "$BROWSER_STATE")
  browser_pid=$(jq -r '.browserPid // empty' "$BROWSER_STATE")
  kill "$pid" 2>/dev/null || true
  for _ in {1..50}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  if [[ -n "$browser_pid" && "$browser_pid" != "$pid" ]] && kill -0 "$browser_pid" 2>/dev/null; then
    kill "$browser_pid" 2>/dev/null || true
  fi
  rm -f "$BROWSER_STATE"
  echo "✓ browser stopped"
}

browser_status() {
  browser_paths
  if [[ -s "$BROWSER_STATE" ]] && kill -0 "$(jq -r .pid "$BROWSER_STATE")" 2>/dev/null; then
    echo "running (pid $(jq -r .pid "$BROWSER_STATE"))"
  else
    echo "stopped"
    return 1
  fi
}

shot() {
  [[ $# -gt 0 ]] || die "usage: dev/run shot <path> --label <name> ..."
  browser_start
  browser_paths
  (cd "$ROOT" && node "$BROWSER_TOOLS/shot.mjs" "$@")
}

capture() {
  local target=${1:-} script
  [[ $# -eq 1 ]] || die "usage: dev/run capture <docs|console>"
  case "$target" in
    docs) script=capture-docs-screenshots.mjs ;;
    console) script=capture-console-audit.mjs ;;
    *) die "usage: dev/run capture <docs|console>" ;;
  esac
  browser_start
  browser_paths
  (cd "$ROOT" && node "$BROWSER_TOOLS/$script")
}

e2e_sso() {
  seed
  load_urls
  curl -fsS "$PORTAL_URL/healthz" >/dev/null ||
    die "Portal is not serving at $PORTAL_URL; run dev/run serve in another terminal"
  (
    cd "$ROOT"
    PORTAL_URL="$PORTAL_URL" \
      KEYCLOAK_ISSUER="$EMISAR_DEV_KEYCLOAK_ISSUER" \
      KEYCLOAK_CA="$CERTS/ca.crt" \
      PROVIDER_ID="11111111-1111-7111-8111-111111111111" \
      SCIM_TOKEN="$SCIM_TOKEN" \
      KC_USER=alice \
      KC_PASS=Sleep-tight-1234 \
      ALICE_KC_ID=a11ce000-0000-4000-8000-000000000001 \
      go run ./tools/cmd/sso-e2e
  )
}

e2e_signing() (
  need docker
  certs_generate
  local compose_project
  compose_project="emisar-signing-e2e-$(printf '%s' "$ROOT" | cksum | awk '{print $1}')"
  export COMPOSE_PROJECT_NAME="$compose_project"
  export PORTAL_PORT=0
  export KEYCLOAK_PORT=0
  (cd "$ROOT" && docker compose --profile test down -v --remove-orphans >/dev/null 2>&1 || true)
  trap 'cd "$ROOT" && docker compose --profile test down -v --remove-orphans >/dev/null 2>&1 || true' EXIT

  echo "[signed-dispatch-e2e] building current portal + runner + mcp images (cached if unchanged)..."
  (cd "$ROOT" && docker compose --profile test build portal runner-signed mcp)

  echo "[signed-dispatch-e2e] bringing up portal + signing-init + runner-signed (profile: test)..."
  (cd "$ROOT" && docker compose --profile test up -d --wait --wait-timeout 120 portal)
  (cd "$ROOT" && docker compose --profile test up -d --force-recreate signing-init runner-signed)
  (cd "$ROOT" && go run ./tools/cmd/signing-e2e)
)

e2e_billing() {
  seed
  load_urls
  EMISAR_DEV_URL=http://localhost:4000
  EMISAR_LISTEN_IP=127.0.0.1
  EMISAR_LISTEN_PORT=4000
  PGPASSWORD=postgres
  export EMISAR_DEV_URL EMISAR_LISTEN_IP EMISAR_LISTEN_PORT PGPASSWORD
  (cd "$BROWSER_TOOLS" && ./paddle-sandbox-e2e.sh)
}

e2e_command() {
  local target=${1:-}
  [[ $# -eq 1 ]] || die "usage: dev/run e2e <sso|signing|billing>"
  case "$target" in
    sso) e2e_sso ;;
    signing) e2e_signing ;;
    billing) e2e_billing ;;
    *) die "usage: dev/run e2e <sso|signing|billing>" ;;
  esac
}

changed_portal_check() {
  local path relative has_changes=0
  local -a format_files=() credo_files=()
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    has_changes=1
    [[ -f "$ROOT/$path" ]] || continue
    relative=${path#portal/}
    case "$relative" in
      *.ex|*.exs|*.heex) format_files+=("$relative") ;;
    esac
    case "$relative" in
      *.ex|*.exs) credo_files+=("$relative") ;;
    esac
  done < <(
    {
      git -C "$ROOT" diff --name-only --diff-filter=ACMR HEAD -- portal
      git -C "$ROOT" ls-files --others --exclude-standard -- portal
    } | sort -u
  )

  if [[ $has_changes -eq 0 ]]; then
    echo "✓ no changed Portal files"
    return
  fi

  (cd "$PORTAL" && mix compile --warnings-as-errors)
  if [[ ${#format_files[@]} -gt 0 ]]; then
    printf 'Checking format: %s\n' "${format_files[*]}"
    (cd "$PORTAL" && mix format --check-formatted "${format_files[@]}")
  fi
  if [[ ${#credo_files[@]} -gt 0 ]]; then
    printf 'Checking Credo: %s\n' "${credo_files[*]}"
    (cd "$PORTAL" && mix credo "${credo_files[@]}")
  fi
}

portal_tests() {
  local app="" arg
  for arg in "$@"; do
    case "$arg" in
      apps/emisar/*)
        [[ -z "$app" || "$app" == emisar ]] || die "focused test paths must belong to one Portal app"
        app=emisar
        ;;
      apps/emisar_web/*)
        [[ -z "$app" || "$app" == emisar_web ]] || die "focused test paths must belong to one Portal app"
        app=emisar_web
        ;;
    esac
  done
  if [[ -z "$app" ]]; then
    (cd "$PORTAL" && env MIX_ENV=test mix test "$@")
    return
  fi

  local -a app_args=()
  for arg in "$@"; do
    case "$arg" in
      "apps/$app/"*) app_args+=("${arg#apps/*/}") ;;
      apps/emisar/*|apps/emisar_web/*)
        die "focused test paths must belong to one Portal app"
        ;;
      *) app_args+=("$arg") ;;
    esac
  done
  (cd "$PORTAL/apps/$app" && env MIX_ENV=test mix test "${app_args[@]}")
}

tooling_check() {
  need shellcheck
  need npm
  need go
  local file
  local -a shell_files=()
  while IFS= read -r -d '' file; do
    [[ -f "$ROOT/$file" ]] || continue
    head -n 1 "$ROOT/$file" | grep -Eq '^#!.*(sh|bash)' || continue
    shell_files+=("$ROOT/$file")
  done < <(
    git -C "$ROOT" ls-files --cached --others --exclude-standard -z -- \
      dev tools/browser .github/scripts
  )
  [[ ${#shell_files[@]} -gt 0 ]] || die "no repository tooling shell programs found"

  shellcheck "${shell_files[@]}"
  for file in "${shell_files[@]}"; do
    bash -n "$file"
  done
  "$ROOT/dev/run_test.sh"
  agent_setup_check
  (cd "$BROWSER_TOOLS" && npm ci --ignore-scripts && npm test)
  echo "✓ development tooling checks passed"
}

agent_setup_check() {
  need go
  (cd "$ROOT" && go run ./tools/cmd/agentcheck "$@")
}

portal_feedback() {
  local level=${1:?} target=${2:-}
  shift 2 || true
  case "$level:$target" in
    check:changed)
      [[ $# -eq 0 ]] || die "usage: dev/run check changed"
      changed_portal_check
      ;;
    check:portal)
      [[ $# -eq 0 ]] || die "usage: dev/run check portal"
      (cd "$PORTAL" && mix compile --warnings-as-errors && mix format --check-formatted && mix credo)
      ;;
    check:tooling)
      [[ $# -eq 0 ]] || die "usage: dev/run check tooling"
      tooling_check
      ;;
    check:agent-setup)
      [[ $# -eq 0 ]] || die "usage: dev/run check agent-setup"
      agent_setup_check --require-coop
      ;;
    test:portal)
      [[ $# -gt 0 ]] || die "usage: dev/run test portal <paths...|--stale|--failed>"
      up
      portal_tests "$@"
      ;;
    gate:portal)
      [[ $# -eq 0 ]] || die "usage: dev/run gate portal"
      up
      (cd "$PORTAL" && mix compile --warnings-as-errors && mix format --check-formatted && mix credo && ../dev/check-portal-test-output.sh)
      ;;
    *) die "usage: dev/run $level <changed|portal|agent-setup|tooling>" ;;
  esac
}

build_pack_tools() {
  mkdir -p "$ROOT/bin"
  (cd "$ROOT/runner" && go build -trimpath -o ../bin/emisar . && go build -trimpath -o ../bin/packctl ./cmd/packctl)
}

pack_command() {
  local action=${1:-} name=${2:-}
  [[ -n "$name" && -d "$ROOT/packs/$name" ]] || die "usage: dev/run pack <check|sync> <pack-name> [--fix]"
  build_pack_tools
  case "$action" in
    check)
      [[ $# -eq 2 ]] || die "usage: dev/run pack check <pack-name>"
      "$ROOT/bin/emisar" pack validate "$ROOT/packs/$name"
      if [[ "$name" == redis || "$name" == cassandra ]]; then
        (cd "$ROOT" && EMISAR_BIN=bin/emisar bash packs/.agent/scripts/check-hash-golden.sh)
      fi
      ;;
    sync)
      [[ "${3:-}" == --fix && $# -eq 3 ]] || die "catalog sync mutates artifacts; pass: dev/run pack sync <pack-name> --fix"
      local previous
      previous=$(mktemp)
      if ! curl -fsS https://registry.emisar.dev/v1/catalog.json -o "$previous"; then
        rm -f "$previous"
        return 1
      fi
      rm -rf "$ROOT/dist"
      if ! "$ROOT/bin/packctl" catalog build --packs "$ROOT/packs" --out "$ROOT/dist" --previous "$previous"; then
        rm -f "$previous"
        return 1
      fi
      rm -f "$previous"
      cp "$ROOT/dist/catalog.json" "$ROOT/portal/apps/emisar/priv/packs/catalog.json"
      (cd "$PORTAL/apps/emisar" && mix test test/emisar/catalog/pack_baseline_test.exs)
      (cd "$PORTAL/apps/emisar_web" && mix test test/emisar_web/packs_registry/cache_test.exs test/emisar_web/packs_test.exs)
      ;;
    *) die "usage: dev/run pack <check|sync> <pack-name> [--fix]" ;;
  esac
}

smoke() {
  certs_generate
  if [[ $CERTS_CHANGED -eq 1 ]]; then
    (cd "$ROOT" && docker compose down)
  fi
  (cd "$ROOT" && docker compose up -d --build)
  echo "✓ packaged stack started at http://localhost:4010"
}

cmd=${1:-}
[[ -n "$cmd" ]] || { usage; exit 2; }
shift
case "$cmd" in
  setup) [[ $# -eq 0 ]] || die "usage: dev/run setup"; setup ;;
  up) [[ $# -eq 0 ]] || die "usage: dev/run up"; up; wait_for_dependencies; urls ;;
  down) in_box && die "run dev/run down on the host"; (cd "$ROOT" && coop down) ;;
  serve) [[ $# -eq 0 ]] || die "usage: dev/run serve"; serve ;;
  seed) [[ $# -eq 0 ]] || die "usage: dev/run seed"; seed ;;
  reset) reset_database "$@" ;;
  urls) [[ $# -eq 0 ]] || die "usage: dev/run urls"; urls ;;
  doctor) [[ $# -eq 0 ]] || die "usage: dev/run doctor"; doctor ;;
  certs) certs_command "$@" ;;
  browser)
    sub=${1:-}; shift || true
    case "$sub" in
      start) browser_start ;;
      stop) browser_stop ;;
      status) browser_status ;;
      install) install_browser ;;
      *) die "usage: dev/run browser <start|stop|status|install>" ;;
    esac
    ;;
  shot) shot "$@" ;;
  capture) capture "$@" ;;
  e2e) e2e_command "$@" ;;
  check|test|gate) portal_feedback "$cmd" "$@" ;;
  pack) pack_command "$@" ;;
  smoke) [[ $# -eq 0 ]] || die "usage: dev/run smoke"; smoke ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
